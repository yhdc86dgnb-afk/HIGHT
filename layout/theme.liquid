<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {{ 'anton-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'space-grotesk-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {%- liquid
      # Una colección con el metacampo custom.acento pinta la tienda con su color. El script de abajo lo
      # recuerda solo durante esa visita; el color que el visitante elige en Elige tu color sí se guarda.
      if request.page_type == 'collection'
        assign page_accent = collection.metafields.custom.acento.value
      endif
      assign page_on_accent = '#0d0c0b'
      if page_accent != blank
        assign page_accent_brightness = page_accent | color_brightness
        if page_accent_brightness < 120
          assign page_on_accent = '#ece3d0'
        endif
      endif

      # Rotación de estilo: cambia sola en casi toda la tienda; en la ficha y el carrito se queda el turno
      # con el que se abrió la página, y en las colecciones de color manda su propio color.
      assign rotation_mode = 'off'
      if settings.rotation_enabled and request.design_mode == false and page_accent == blank
        assign rotation_mode = 'live'
        if request.page_type == 'product' or request.page_type == 'cart'
          assign rotation_mode = 'static'
        endif
      endif
      assign rotation_pieces = false
      if request.page_type == 'index' and settings.rotation_garments
        assign rotation_pieces = true
      endif
    -%}

    {% render 'css-variables', page_accent: page_accent, page_on_accent: page_on_accent %}
    {{ 'hight.css' | asset_url | stylesheet_tag }}

    {%- if settings.page_transitions -%}
      <style>
        @view-transition {
          navigation: auto;
        }
      </style>
    {%- endif -%}

    {%- if settings.visitor_accent -%}
      <script>
        try {
          {%- if page_accent != blank %}
            sessionStorage.setItem(
              'hight-accent-visit',
              JSON.stringify({ color: '{{ page_accent }}', on: '{{ page_on_accent }}', name: {{ collection.title | json }} })
            );
          {%- else %}
            var hightAccent = JSON.parse(
              sessionStorage.getItem('hight-accent-visit') || localStorage.getItem('hight-accent') || 'null'
            );
            if (hightAccent && /^#[0-9a-f]{6}$/i.test(hightAccent.color) && /^#[0-9a-f]{6}$/i.test(hightAccent.on)) {
              document.documentElement.style.setProperty('--accent', hightAccent.color);
              document.documentElement.style.setProperty('--on-accent', hightAccent.on);
            }
          {%- endif %}
        } catch (e) {}
      </script>
    {%- endif -%}

    {% render 'rotation-data', mode: rotation_mode, pieces: rotation_pieces %}

    <script src="{{ 'hight.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-{{ request.page_type | handle }}{% if settings.grain %} hi-grain{% endif %}{% if settings.motion %} hi-motion{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div class="hi-toast-region" data-toast-region role="status" aria-live="polite"></div>

    <script type="application/json" id="HightConfig">
      {
        "routes": {
          "root": {{ routes.root_url | json }},
          "cart": {{ routes.cart_url | json }},
          "cartAdd": {{ routes.cart_add_url | json }},
          "cartChange": {{ routes.cart_change_url | json }},
          "predictiveSearch": {{ routes.predictive_search_url | json }},
          "productRecommendations": {{ routes.product_recommendations_url | json }}
        },
        "moneyFormat": {{ shop.money_format | json }},
        "cartType": {{ settings.cart_type | json }},
        "motion": {{ settings.motion | json }},
        "cursorLabel": {{ settings.cursor_label | json }},
        "cardTilt": {{ settings.card_tilt | json }},
        "visitorAccent": {{ settings.visitor_accent | json }},
        "viewer360": {{ 'hight-360.js' | asset_url | json }},
        "strings": {
          "addToCart": {{ 'products.add_to_cart' | t | json }},
          "soldOut": {{ 'products.sold_out' | t | json }},
          "unavailable": {{ 'products.unavailable' | t | json }},
          "added": {{ 'cart.added' | t | json }},
          "viewCart": {{ 'cart.view' | t | json }},
          "error": {{ 'cart.error' | t | json }},
          "close": {{ 'accessibility.close' | t | json }},
          "slideCount": {{ 'products.gallery_count' | t | json }},
          "accentChanged": {{ 'color_story.changed' | t: name: '[name]' | json }},
          "accentReset": {{ 'color_story.reset_done' | t | json }},
          "v360": {
            "title": {{ 'vista_360.title' | t | json }},
            "loading": {{ 'vista_360.loading' | t | json }},
            "hint": {{ 'vista_360.hint' | t | json }},
            "front": {{ 'vista_360.front' | t | json }},
            "side": {{ 'vista_360.side' | t | json }},
            "back": {{ 'vista_360.back' | t | json }},
            "top": {{ 'vista_360.top' | t | json }},
            "bottom": {{ 'vista_360.bottom' | t | json }},
            "auto": {{ 'vista_360.auto' | t | json }},
            "threeQuarters": {{ 'vista_360.three_quarters' | t | json }},
            "threeQuartersBack": {{ 'vista_360.three_quarters_back' | t | json }},
            "fromAbove": {{ 'vista_360.from_above' | t | json }},
            "fromBelow": {{ 'vista_360.from_below' | t | json }},
            "stage": {{ 'vista_360.stage' | t | json }},
            "backPhoto": {{ 'vista_360.back_photo' | t | json }},
            "backReference": {{ 'vista_360.back_reference' | t | json }},
            "backSketch": {{ 'vista_360.back_sketch' | t | json }},
            "error": {{ 'vista_360.error' | t | json }},
            "close": {{ 'accessibility.close' | t | json }}
          }
        }
      }
    </script>
  </body>
</html>
