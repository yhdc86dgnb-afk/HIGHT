<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {{ 'archivo-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% render 'css-variables' %}
    {{ 'hight.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'hight.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
