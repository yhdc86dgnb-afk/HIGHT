  {
    "name": "Logo y favicon",
    "settings": [
      {
        "type": "paragraph",
        "content": "Por defecto el header y el footer usan la firma corta de Hight (la palabra HIGHT de palo seco). El logo gótico principal vive en las secciones de campaña."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Reemplazar firma del header",
        "info": "Opcional. Déjalo vacío para usar la firma HIGHT del design system."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Alto de la firma en el header",
        "min": 16,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Opcional. 180 × 180 px. Vacío usa el monograma H con estrella."
      }
    ]
  },
  {
    "name": "Productos",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_meta",
        "label": "Mostrar corte y material en las tarjetas",
        "info": "Usa el metacampo custom.corte_material (ej. Boxy · 280 g/m²) o, si no existe, el tipo de producto.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Mostrar muestras de color en las tarjetas",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_second_image",
        "label": "Mostrar la segunda foto al pasar el cursor",
        "default": false
      },
      {
        "type": "text",
        "id": "drop_tag_prefix",
        "label": "Prefijo de etiqueta de drop",
        "info": "Un producto con la etiqueta \"DROP 05\" muestra esa marquilla en aura sobre la foto.",
        "default": "DROP"
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Avisar \"Quedan N unidades\" desde",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 5,
        "info": "0 desactiva el aviso. La escasez se dice con datos."
      },
      {
        "type": "textarea",
        "id": "swatch_colors",
        "label": "Colores de las muestras",
        "info": "Una línea por color: Nombre: #hex. Se usa cuando la opción de color no tiene muestra propia en Shopify.",
        "default": "Plata: #c0c4ca\nCarbón: #2b2e33\nAzul noche: #121c33\nNegro: #0b0c0f\nNegro lavado: #2a2b2f\nBlanco: #f2f2ef\nNiebla: #b9bec7\nConcreto: #8d9097\nGris: #8a8d93\nAzul: #1d4f8a"
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Al agregar al carrito",
        "options": [
          {
            "value": "drawer",
            "label": "Abrir el carrito lateral"
          },
          {
            "value": "page",
            "label": "Ir a la página del carrito"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Envío gratis desde",
        "info": "En la moneda de la tienda, sin decimales (ej. 250000). 0 oculta el aviso.",
        "default": 250000
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Permitir nota del pedido",
        "default": false
      },
      {
        "type": "url",
        "id": "cart_empty_link",
        "label": "Enlace de \"VER EL DROP\" con el carrito vacío"
      }
    ]
  },
