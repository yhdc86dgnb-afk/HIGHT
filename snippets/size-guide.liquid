{%- doc -%}
  SizeGuide del design system: tablas de medidas de la prenda en plano, en cm, con la talla
  seleccionada resaltada. Las tablas base salen de la sección Tallas del sistema
  (design-system/secciones/05-tallas.md): reemplázalas por las del patronaje real.

  @param {string} [guide] - camiseta, hoodie, pantalon o all (todas)
  @param {string} [highlight] - Talla a resaltar
{%- enddoc -%}
{%- liquid
  assign guide_key = guide | default: 'all'
-%}
<div data-size-guide>
  {%- if guide_key == 'camiseta' or guide_key == 'all' -%}
    {%- assign guide_sizes = 'S,M,L,XL' | split: ',' -%}
    <figure class="hi-sizeguide">
      <figcaption>
        <span class="hi-sizeguide-title">Camiseta boxy</span>
        <span class="hi-sizeguide-note">Corte boxy: hombro caído y largo corto. Si quieres más holgura, sube una talla.</span>
      </figcaption>
      <div class="hi-sizeguide-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">MEDIDA (CM)</th>
              {%- for guide_size in guide_sizes -%}
                <th scope="col" data-size="{{ guide_size }}" {% if guide_size == highlight %}class="is-on"{% endif %}>{{ guide_size }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- render 'size-guide-row', label: 'Ancho de pecho', values: '56,59,62,65', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Largo total', values: '68,70,72,74', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Hombro a hombro', values: '54,56,58,60', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Largo de manga', values: '22,23,24,25', sizes: guide_sizes, highlight: highlight -%}
          </tbody>
        </table>
      </div>
    </figure>
  {%- endif -%}

  {%- if guide_key == 'hoodie' or guide_key == 'all' -%}
    {%- assign guide_sizes = 'S,M,L,XL' | split: ',' -%}
    <figure class="hi-sizeguide">
      <figcaption>
        <span class="hi-sizeguide-title">Hoodie boxy</span>
        <span class="hi-sizeguide-note">Medidas de la prenda en plano. El largo de manga se mide desde el cuello.</span>
      </figcaption>
      <div class="hi-sizeguide-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">MEDIDA (CM)</th>
              {%- for guide_size in guide_sizes -%}
                <th scope="col" data-size="{{ guide_size }}" {% if guide_size == highlight %}class="is-on"{% endif %}>{{ guide_size }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- render 'size-guide-row', label: 'Ancho de pecho', values: '62,65,68,71', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Largo total', values: '66,68,70,72', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Largo de manga', values: '78,80,82,84', sizes: guide_sizes, highlight: highlight -%}
          </tbody>
        </table>
      </div>
    </figure>
  {%- endif -%}

  {%- if guide_key == 'pantalon' or guide_key == 'all' -%}
    {%- assign guide_sizes = '28,30,32,34,36' | split: ',' -%}
    <figure class="hi-sizeguide">
      <figcaption>
        <span class="hi-sizeguide-title">Pantalón wide</span>
        <span class="hi-sizeguide-note">Tallas por cintura. Cintura y bota se miden de lado a lado × 2.</span>
      </figcaption>
      <div class="hi-sizeguide-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">MEDIDA (CM)</th>
              {%- for guide_size in guide_sizes -%}
                <th scope="col" data-size="{{ guide_size }}" {% if guide_size == highlight %}class="is-on"{% endif %}>{{ guide_size }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- render 'size-guide-row', label: 'Cintura', values: '74,78,82,86,90', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Cadera', values: '104,108,112,116,120', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Tiro delantero', values: '30,31,32,33,34', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Largo exterior', values: '106,108,110,112,112', sizes: guide_sizes, highlight: highlight -%}
            {%- render 'size-guide-row', label: 'Bota', values: '56,58,60,62,64', sizes: guide_sizes, highlight: highlight -%}
          </tbody>
        </table>
      </div>
    </figure>
  {%- endif -%}
</div>
