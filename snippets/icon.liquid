{%- doc -%}
  Ícono Espina de Hight: los íconos de Google (Material Symbols) redibujados con la estética
  del logo (puntas, púas y rombos). Relleno sólido en currentColor: hereda el color del texto.
  Generado a partir de design-system/componentes/bundle.js.

  @param {string} name - Nombre de Google (`shopping_bag`) o alias en español (`bolsa`)
  @param {number} [size] - Tamaño en px: 20, 24 (por defecto), 32 o 48. A 16 solo add, remove, close y expand_more
  @param {string} [label] - Texto para lectores de pantalla. Sin label el ícono es decorativo
  @param {string} [class] - Clases extra para el svg

  @example
  {% render 'icon', name: 'shopping_bag' %}
  {% render 'icon', name: 'close', size: 16, label: 'Cerrar' %}
{%- enddoc -%}
{%- liquid
  assign icon_name = name
  case name
    when 'bolsa'
      assign icon_name = 'shopping_bag'
    when 'buscar'
      assign icon_name = 'search'
    when 'usuario'
      assign icon_name = 'person'
    when 'cerrar'
      assign icon_name = 'close'
    when 'flecha-der'
      assign icon_name = 'arrow_forward'
    when 'flecha-izq'
      assign icon_name = 'arrow_back'
    when 'chevron-abajo'
      assign icon_name = 'expand_more'
    when 'chevron-arriba'
      assign icon_name = 'expand_less'
    when 'chevron-der'
      assign icon_name = 'chevron_right'
    when 'chevron-izq'
      assign icon_name = 'chevron_left'
    when 'mas'
      assign icon_name = 'add'
    when 'menos'
      assign icon_name = 'remove'
    when 'corazon'
      assign icon_name = 'favorite'
    when 'envio'
      assign icon_name = 'local_shipping'
    when 'devolucion'
      assign icon_name = 'undo'
    when 'regla'
      assign icon_name = 'straighten'
    when 'alerta'
      assign icon_name = 'warning'
    when 'filtro'
      assign icon_name = 'tune'
    when 'ordenar'
      assign icon_name = 'swap_vert'
    when 'estrella'
      assign icon_name = 'flare'
    when 'candado'
      assign icon_name = 'lock'
    when 'tarjeta'
      assign icon_name = 'credit_card'
    when 'ubicacion'
      assign icon_name = 'location_on'
    when 'correo'
      assign icon_name = 'mail'
    when 'chat'
      assign icon_name = 'chat_bubble'
    when 'externo'
      assign icon_name = 'open_in_new'
    when 'cuadricula'
      assign icon_name = 'grid_view'
    when 'ojo'
      assign icon_name = 'visibility'
    when 'lavar-frio'
      assign icon_name = 'lavar_frio'
    when 'no-blanquear'
      assign icon_name = 'no_blanquear'
    when 'planchar-bajo'
      assign icon_name = 'planchar_bajo'
    when 'no-secadora'
      assign icon_name = 'no_secadora'
  endcase
  assign icon_size = size | default: 24
-%}
<svg
  class="hi-icon {{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="currentColor"
  focusable="false"
  {% if label != blank %}
    role="img" aria-label="{{ label | escape }}"
  {% else %}
    aria-hidden="true"
  {% endif %}
