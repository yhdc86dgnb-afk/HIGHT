{%- doc -%}
  Galería de la ficha. En el teléfono las fotos se deslizan con contador "01 / 03"; en computador
  se apilan en su proporción, como copias impresas, y cada una abre el visor ampliado.

  @param {product} product - Producto
  @param {variant} current_variant - Variante seleccionada (su foto se muestra primero)
  @param {string} section_id - id de la sección, para ids únicos
  @param {string} [zoom_id] - id del diálogo de fotos ampliadas
{%- enddoc -%}
{%- liquid
  assign gallery_count = product.media.size
  assign start_index = 1
  if current_variant.featured_media
    for media in product.media
      if media.id == current_variant.featured_media.id
        assign start_index = forloop.index
        break
      endif
    endfor
  endif
  assign count_text = gallery_count
  if gallery_count < 10
    assign count_text = '0' | append: gallery_count
  endif
  assign start_text = start_index
  if start_index < 10
    assign start_text = '0' | append: start_index
  endif
-%}
<media-gallery class="hi-gallery" data-start="{{ start_index }}">
  <div class="hi-gallery-main">
    <ul class="hi-gallery-track" aria-label="{{ 'products.gallery_label' | t }}" data-gallery-track>
      {%- for media in product.media -%}
        {%- liquid
          assign media_loading = 'lazy'
          if forloop.index == start_index or forloop.first
            assign media_loading = 'eager'
          endif
          assign media_alt = media.alt | default: product.title
        -%}
        <li
          class="hi-gallery-slide"
          id="Slide-{{ section_id }}-{{ media.id }}"
          data-media-id="{{ media.id }}"
          style="--ar: {{ media.aspect_ratio | default: 0.8 }};"
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- if zoom_id != blank -%}
                <button
                  type="button"
                  class="hi-gallery-zoom hi-print"
                  aria-label="{{ 'products.zoom' | t: index: forloop.index }}"
                  aria-haspopup="dialog"
                  data-zoom="{{ zoom_id }}"
                  data-zoom-target="{{ zoom_id }}-{{ media.id }}"
                  data-cursor="{{ 'general.cursor_zoom' | t }}"
                >
                  {{
                    media
                    | image_url: width: 1800
                    | image_tag:
                      widths: '450, 600, 750, 900, 1200, 1500, 1800',
                      sizes: '(min-width: 1440px) 820px, (min-width: 990px) 56vw, 100vw',
                      loading: media_loading,
                      alt: media_alt
                  }}
                </button>
              {%- else -%}
                <div class="hi-print">
                  {{
                    media
                    | image_url: width: 1800
                    | image_tag:
                      widths: '450, 600, 750, 900, 1200, 1500, 1800',
                      sizes: '(min-width: 1440px) 820px, (min-width: 990px) 56vw, 100vw',
                      loading: media_loading,
                      alt: media_alt
                  }}
                </div>
              {%- endif -%}
            {%- when 'video' -%}
              <div class="hi-print">
                {{ media | video_tag: image_size: '1080x', controls: true, muted: true, playsinline: true, loop: true }}
              </div>
            {%- when 'external_video' -%}
              <div class="hi-print">{{ media | external_video_tag }}</div>
            {%- else -%}
              <div class="hi-print">{{ media | media_tag }}</div>
          {%- endcase -%}
        </li>
      {%- else -%}
        <li class="hi-gallery-slide" style="--ar: 0.8;">
          <div class="hi-print">
            <span class="hi-media-ph" aria-hidden="true">{{ 'products.photo_placeholder' | t }}</span>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if gallery_count > 1 -%}
      <span class="hi-gallery-count" data-gallery-count aria-hidden="true">{{ start_text }} / {{ count_text }}</span>
    {%- endif -%}
  </div>

  {%- if gallery_count > 1 -%}
    <ul class="hi-gallery-thumbs">
      {%- for media in product.media -%}
        <li>
          <button
            type="button"
            aria-label="{{ 'products.thumbnail' | t: index: forloop.index }}"
            data-thumb="{{ media.id }}"
            {% if forloop.index == start_index %}
              aria-current="true"
            {% endif %}
          >
            {{ media.preview_image | image_url: width: 176 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</media-gallery>
