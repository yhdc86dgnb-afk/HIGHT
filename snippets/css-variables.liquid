{%- doc -%}
  Carga las tipografías de Hight (alojadas en el tema) y publica los tokens de color de cada
  esquema del editor como variables CSS. El primer esquema (Plata) aplica a toda la página;
  una sección con otro esquema (Aura) redefine las variables dentro de su clase .color-scheme-N.
{%- enddoc -%}
{%- style -%}
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url({{ 'archivo-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'ibm-plex-mono-400-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url({{ 'ibm-plex-mono-500-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Instrument Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'instrument-serif-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Instrument Serif';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'instrument-serif-italic-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Hight Espina';
    font-style: normal;
    font-weight: 800;
    font-display: swap;
    src: url({{ 'hight-espina.woff' | asset_url }}) format('woff');
  }
  @font-face {
    font-family: 'Hight Espina Hueso';
    font-style: normal;
    font-weight: 800;
    font-display: swap;
    src: url({{ 'hight-espina-hueso.woff' | asset_url }}) format('woff');
  }

  {% for scheme in settings.color_schemes -%}
    {%- assign scheme_brightness = scheme.settings.surface_000 | color_brightness -%}
    {% if forloop.first %}:root, {% endif %}.color-{{ scheme.id }} {
      --surface-000: {{ scheme.settings.surface_000 }};
      --surface-100: {{ scheme.settings.surface_100 }};
      --surface-200: {{ scheme.settings.surface_200 }};
      --line: {{ scheme.settings.line }};
      --line-strong: {{ scheme.settings.line_strong }};
      --ink: {{ scheme.settings.ink }};
      --ink-muted: {{ scheme.settings.ink_muted }};
      --on-ink: {{ scheme.settings.on_ink }};
      --focus: {{ scheme.settings.ink }};
      --aura: {{ scheme.settings.aura }};
      --on-aura: {{ scheme.settings.on_aura }};
      --cyan: {{ scheme.settings.cyan }};
      --haze: {{ scheme.settings.haze }};
      --success: {{ scheme.settings.success }};
      --warning: {{ scheme.settings.warning }};
      --danger: {{ scheme.settings.danger }};
      {%- if scheme_brightness < 128 %}
        --shadow-overlay: 0 24px 48px rgba(0, 0, 0, 0.65);
        --glow-aura: 0 0 32px rgba(111, 162, 255, 0.55);
        color-scheme: dark;
      {%- else %}
        --shadow-overlay: 0 24px 48px rgba(10, 21, 48, 0.18);
        --glow-aura: 0 0 24px rgba(31, 79, 176, 0.35);
        color-scheme: light;
      {%- endif %}
    }
  {% endfor %}
{%- endstyle -%}
