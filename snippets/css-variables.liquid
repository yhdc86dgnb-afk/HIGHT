{%- doc -%}
  Carga las tipografías del tema (Anton, Space Grotesk y Space Mono, alojadas en assets) y publica
  cada esquema del editor como variables CSS. El primer esquema aplica a toda la página; una sección
  con otro esquema redefine las variables dentro de su clase .color-scheme-N.

  El acento es global (--accent). Los esquemas oscuros y neutros usan el acento en los botones;
  los claros y los muy saturados (carmín, ácido) invierten el botón con su propio texto y fondo.
{%- enddoc -%}
{%- liquid
  assign accent_brightness = settings.accent | color_brightness
  assign on_accent = '#0d0c0b'
  if accent_brightness < 120
    assign on_accent = '#ece3d0'
  endif
-%}
{%- style -%}
  @font-face {
    font-family: 'Anton';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'anton-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Space Grotesk';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url({{ 'space-grotesk-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Space Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'space-mono-400-latin.woff2' | asset_url }}) format('woff2');
  }
  @font-face {
    font-family: 'Space Mono';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url({{ 'space-mono-700-latin.woff2' | asset_url }}) format('woff2');
  }

  :root {
    --accent: {{ settings.accent }};
    --on-accent: {{ on_accent }};
    --accent-default: {{ settings.accent }};
    --on-accent-default: {{ on_accent }};
    --grain-url: url({{ 'grano.svg' | asset_url }});
  }

  {% for scheme in settings.color_schemes -%}
    {%- liquid
      assign scheme_brightness = scheme.settings.background | color_brightness
      assign scheme_saturation = scheme.settings.background | color_extract: 'saturation'
      assign scheme_inverted = false
      if scheme_brightness > 150 or scheme_saturation > 70
        assign scheme_inverted = true
      endif
    -%}
    {% if forloop.first %}:root, {% endif %}.color-{{ scheme.id }} {
      --bg: {{ scheme.settings.background }};
      --surface: {{ scheme.settings.surface }};
      --text: {{ scheme.settings.text }};
      --muted: {{ scheme.settings.muted }};
      --line: {{ scheme.settings.line }};
      --print: {{ scheme.settings.print }};
      {%- if scheme_inverted %}
        --btn-bg: var(--text);
        --btn-fg: var(--bg);
        --hl: var(--text);
        --on-hl: var(--bg);
      {%- else %}
        --btn-bg: var(--accent);
        --btn-fg: var(--on-accent);
        --hl: var(--accent);
        --on-hl: var(--on-accent);
      {%- endif %}
      {%- if scheme_brightness < 128 %}
        --logo: url({{ 'hight-logo-plata.webp' | asset_url }});
        --shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
        --danger: #ff8a7a;
        --success: #a6e39a;
        color-scheme: dark;
      {%- else %}
        --logo: url({{ 'hight-logo-tinta.webp' | asset_url }});
        --shadow: 0 30px 60px rgba(13, 12, 11, 0.22);
        --danger: #9e1222;
        --success: #1d6a37;
        color-scheme: light;
      {%- endif %}
    }
  {% endfor %}
{%- endstyle -%}
