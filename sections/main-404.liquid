<div class="hi-container hi-page hi-404">
  <p class="hi-404-n" aria-hidden="true">404</p>
  <p class="t-label">{{ 'errors.not_found_label' | t }}</p>
  <h1 class="t-display-l">{{ 'errors.not_found_title' | t }}</h1>
  <p class="t-body-l t-muted t-measure">{{ 'errors.not_found_body' | t }}</p>
  <div class="hi-404-actions">
    <a href="{{ routes.all_products_collection_url }}" class="hi-btn hi-btn-primary hi-btn-lg">
      {{- 'general.view_pieces' | t }}
      {% render 'icon', name: 'arrow_forward', size: 20 -%}
    </a>
    <a href="{{ routes.root_url }}" class="hi-btn hi-btn-secondary hi-btn-lg">{{ 'general.continue_shopping' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Página no encontrada",
  "tag": "section",
  "class": "hi-main-404-section"
}
{% endschema %}
