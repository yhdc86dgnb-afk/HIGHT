<footer class="hi-footer color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_newsletter -%}
    <div class="hi-footer-news hi-bg-accent">
      <div class="hi-container hi-footer-news-inner">
        <div class="hi-footer-news-copy">
          <h2 class="t-display-l">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="t-body-l">{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}
        </div>
        {%- form 'customer', id: 'FooterNewsletter', class: 'hi-footer-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="hi-field{% if form.errors %} hi-field-invalid{% endif %}">
            <label for="FooterNewsletterEmail">{{ 'newsletter.email_label' | t }}</label>
            <div class="hi-field-inline">
              <input
                id="FooterNewsletterEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ 'newsletter.placeholder' | t }}"
                autocomplete="email"
                autocapitalize="off"
                required
                aria-describedby="FooterNewsletterHint"
              >
              <button type="submit" class="hi-btn hi-btn-primary">{{ 'newsletter.submit' | t }}</button>
            </div>
            {%- if form.errors -%}
              <span class="hi-field-error" id="FooterNewsletterHint" role="alert">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            {%- elsif form.posted_successfully? -%}
              <span class="hi-form-success" id="FooterNewsletterHint" role="status">{{ 'newsletter.success' | t }}</span>
            {%- else -%}
              <span class="hi-field-hint" id="FooterNewsletterHint">{{ 'newsletter.hint' | t }}</span>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="hi-container hi-footer-inner">
    {%- if section.blocks.size > 0 -%}
      <div class="hi-footer-cols">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.menu.links.size > 0 -%}
                <nav aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
                  <p class="hi-footer-title">{{ block.settings.title | escape }}</p>
                  <ul role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}
            {%- when 'social' -%}
              {%- liquid
                assign social_any = false
                if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_whatsapp != blank or settings.social_youtube != blank or settings.social_spotify != blank
                  assign social_any = true
                endif
                if block.settings.menu.links.size > 0
                  assign social_any = true
                endif
              -%}
              {%- if social_any -%}
                <nav aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
                  <p class="hi-footer-title">{{ block.settings.title | escape }}</p>
                  <ul role="list">
                    {%- render 'social-links', list: true -%}
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}
            {%- when 'legal' -%}
              <nav aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
                <p class="hi-footer-title">{{ block.settings.title | escape }}</p>
                <ul role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}">{{ link.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                  {%- if block.settings.show_policies -%}
                    {%- for policy in shop.policies -%}
                      {%- if policy.body != blank -%}
                        <li>
                          <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </nav>
            {%- when 'text' -%}
              <div {{ block.shopify_attributes }}>
                <p class="hi-footer-title">{{ block.settings.title | escape }}</p>
                <div class="hi-footer-text rte">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_big_logo -%}
      <a href="{{ routes.root_url }}" class="hi-footer-logo" aria-label="{{ 'accessibility.home' | t: shop: shop.name }}" data-reveal>
        <span class="hi-logo-img" aria-hidden="true"></span>
      </a>
    {%- endif -%}

    <div class="hi-footer-bottom t-label">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase | escape }}</span>
      {%- if section.settings.tagline != blank -%}
        <span>{{ section.settings.tagline | escape }}</span>
      {%- endif -%}
      {%- if section.settings.origin != blank -%}
        <span>{{ section.settings.origin | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Mostrar suscripción por correo",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Titular de la suscripción",
      "default": "ENTÉRATE PRIMERO"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Texto de la suscripción",
      "default": "Las piezas únicas se van rápido. Te avisamos cuando entren nuevas."
    },
    {
      "type": "checkbox",
      "id": "show_big_logo",
      "label": "Mostrar el logo gigante",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Lema",
      "default": "Piezas únicas y denim intervenido."
    },
    {
      "type": "text",
      "id": "origin",
      "label": "Sello de origen",
      "default": "MED/COL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de menú",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Tienda"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú",
          "default": "footer"
        }
      ]
    },
    {
      "type": "social",
      "name": "Columna de redes",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Redes"
        },
        {
          "type": "paragraph",
          "content": "Las redes se configuran en Configuración del tema > Redes sociales."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Enlaces extra (opcional)"
        }
      ]
    },
    {
      "type": "legal",
      "name": "Columna legal",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Legal"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú",
          "info": "En Colombia incluye siempre \"Tratamiento de datos\" (Ley 1581)."
        },
        {
          "type": "checkbox",
          "id": "show_policies",
          "label": "Listar las políticas de la tienda",
          "default": true
        }
      ]
    },
    {
      "type": "text",
      "name": "Columna de texto",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Taller"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Escríbenos si tienes dudas sobre una pieza.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
