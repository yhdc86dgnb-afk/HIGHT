{%- if section.settings.text != blank -%}
  <div
    class="hi-announce hi-announce-{{ section.settings.tone }}{% if section.settings.tone == 'metal' %} hi-metal{% endif %}"
    role="region"
    aria-label="{{ 'accessibility.announcement' | t }}"
  >
    <span>{{ section.settings.text | escape }}</span>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="hi-announce-link">{{ section.settings.link_label | default: 'VER' | escape }} &rarr;</a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "class": "hi-announce-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Un mensaje a la vez, con un dato concreto: envíos, fecha de drop o un cambio de política."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Mensaje",
      "default": "Envío gratis en Medellín desde $250.000"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "VER"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Tono",
      "options": [
        {
          "value": "ink",
          "label": "Tinta (todo el año)"
        },
        {
          "value": "metal",
          "label": "Metal (anunciar un drop que viene)"
        },
        {
          "value": "aura",
          "label": "Aura (solo el día del lanzamiento)"
        }
      ],
      "default": "ink"
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncio"
    }
  ]
}
{% endschema %}
