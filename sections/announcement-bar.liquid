{%- liquid
  assign announce_class = 'hi-bg-accent'
  if section.settings.tone == 'scheme'
    assign announce_class = 'color-' | append: section.settings.color_scheme
  endif

  # Con la rotación de estilo, la cinta dice el color de ahora (después del primer mensaje) y el que
  # sigue (después del segundo). Los llena snippets/rotation-data.liquid antes de que se vean.
  assign show_turn = false
  if settings.rotation_enabled and request.design_mode == false and section.settings.show_turn
    assign show_turn = true
  endif
  assign turn_next_after = 2
  if section.blocks.size == 1
    assign turn_next_after = 1
  endif
-%}
{%- if section.blocks.size > 0 -%}
  {%- capture announce_items -%}
    {%- for block in section.blocks -%}
      <li class="hi-marquee-item">
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
        {%- else -%}
          <span>{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </li>
      <li class="hi-marquee-sep" aria-hidden="true">{% render 'icon', name: 'flare', size: 16 %}</li>
      {%- if show_turn and forloop.index == 1 -%}
        <li class="hi-marquee-item" data-turn-show hidden>
          <span data-turn-template="{{ 'rotation.cinta_now' | t: name: '[name]' }}"></span>
        </li>
        <li class="hi-marquee-sep" aria-hidden="true" data-turn-show hidden>
          {%- render 'icon', name: 'flare', size: 16 -%}
        </li>
      {%- endif -%}
      {%- if show_turn and forloop.index == turn_next_after -%}
        <li class="hi-marquee-item" data-turn-show hidden>
          <span data-turn-template="{{ 'rotation.cinta_next' | t: name: '[next]' }}"></span>
        </li>
        <li class="hi-marquee-sep" aria-hidden="true" data-turn-show hidden>
          {%- render 'icon', name: 'flare', size: 16 -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <div
    class="hi-announce {{ announce_class }}"
    role="region"
    aria-label="{{ 'accessibility.announcement' | t }}"
  >
    <hi-marquee class="hi-marquee" style="--marquee-duration: {{ section.settings.speed }}s;" data-speed="{{ section.settings.speed }}">
      <div class="hi-marquee-track">
        <ul class="hi-marquee-group" role="list">
          {{ announce_items }}
          {{ announce_items }}
          {{ announce_items }}
        </ul>
        <ul class="hi-marquee-group" role="list" aria-hidden="true" inert>
          {{ announce_items }}
          {{ announce_items }}
          {{ announce_items }}
        </ul>
      </div>
    </hi-marquee>
    {%- if show_turn -%}
      <script>
        window.HightRotation && window.HightRotation.text && window.HightRotation.text(document.currentScript.parentNode, window.HightRotation.shown);
      </script>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "class": "hi-announce-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Mensajes cortos que corren de lado a lado. Si prometes algo (envíos, tiempos, cambios), que sea algo que la tienda cumple."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duración de una vuelta",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 36
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo",
      "options": [
        {
          "value": "accent",
          "label": "Color de acento"
        },
        {
          "value": "scheme",
          "label": "Esquema de color"
        }
      ],
      "default": "accent"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.tone == 'scheme' }}"
    },
    {
      "type": "checkbox",
      "id": "show_turn",
      "label": "Decir el color de ahora y el que sigue",
      "info": "Con la rotación de estilo encendida, la cinta suma AHORA y SIGUE con los colores del turno.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "EDICIONES CORTAS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncio",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "EDICIONES CORTAS"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "DENIM INTERVENIDO"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "PRENDAS DE ARCHIVO"
          }
        }
      ]
    }
  ]
}
{% endschema %}
