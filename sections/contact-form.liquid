<div class="hi-container hi-section">
  {%- form 'contact', id: 'ContactForm', class: 'hi-form-stack' -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="t-h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <p class="hi-notice hi-notice-success" role="status">
        <span class="hi-notice-mark">OK</span>
        <span>{{ 'contact.success' | t }}</span>
      </p>
    {%- elsif form.errors -%}
      <div class="hi-notice hi-notice-danger" role="alert">
        <span class="hi-notice-mark">!</span>
        <span class="hi-notice-title">{{ 'contact.error' | t }}</span>
        <span>{{ form.errors | default_errors }}</span>
      </div>
    {%- endif -%}

    <div class="hi-field-row">
      <div class="hi-field">
        <label for="ContactForm-name">{{ 'contact.name' | t }}</label>
        <input type="text" id="ContactForm-name" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="hi-field{% if form.errors contains 'email' %} hi-field-invalid{% endif %}">
        <label for="ContactForm-email">{{ 'contact.email' | t }}</label>
        <input
          type="email"
          id="ContactForm-email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          value="{{ form.email }}"
        >
      </div>
    </div>
    <div class="hi-field">
      <label for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
      <input type="tel" id="ContactForm-phone" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
    </div>
    <div class="hi-field">
      <label for="ContactForm-body">{{ 'contact.message' | t }}</label>
      <textarea id="ContactForm-body" name="contact[body]" rows="6">{{ form.body }}</textarea>
    </div>
    <div>
      <button type="submit" class="hi-btn hi-btn-primary hi-btn-lg">{{ 'contact.submit' | t }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Formulario de contacto",
  "tag": "section",
  "class": "hi-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Escríbenos"
    }
  ],
  "presets": [
    {
      "name": "Formulario de contacto"
    }
  ]
}
{% endschema %}
