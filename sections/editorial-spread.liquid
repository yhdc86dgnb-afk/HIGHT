{%- liquid
  assign look_images = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.product != blank
      assign look_images = look_images | plus: 1
    endif
  endfor
-%}

{%- if look_images > 0 or request.design_mode -%}
  <section class="hi-section hi-lookbook color-{{ section.settings.color_scheme }}">
    <div class="hi-container">
      <div class="hi-lookbook-head" data-reveal>
        {%- if section.settings.label != blank -%}
          <p class="t-label">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="t-display-l">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      <div class="hi-lookbook-board">
        {%- for block in section.blocks -%}
          {%- liquid
            assign look_product = block.settings.product
            assign look_image = block.settings.image
            if look_image == blank and look_product != blank
              assign look_image = look_product.featured_media.preview_image
            endif
            assign look_alt = look_image.alt | default: block.settings.caption | default: look_product.title
            assign look_tag = 'div'
            if look_product != blank
              assign look_tag = 'a'
            endif
          -%}
          {%- if look_image != blank or request.design_mode -%}
            <figure class="hi-look hi-look--{{ forloop.index | modulo: 3 }}" style="--r: {% cycle '-3deg', '2.5deg', '-1.5deg' %};" data-reveal {{ block.shopify_attributes }}>
              <{{ look_tag }}
                class="hi-look-print hi-print"
                {% if look_tag == 'a' %}
                  href="{{ look_product.url }}" data-cursor="{{ 'general.cursor_view' | t }}"
                {% endif %}
              >
                <span class="hi-tape" aria-hidden="true"></span>
                {%- if look_image != blank -%}
                  {{
                    look_image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '450, 700, 1000, 1400',
                      sizes: '(min-width: 990px) 34vw, 80vw',
                      loading: 'lazy',
                      alt: look_alt
                  }}
                {%- else -%}
                  <span class="hi-media-ph" aria-hidden="true">{{ 'products.photo_placeholder' | t }}</span>
                {%- endif -%}
              </{{ look_tag }}>
              {%- if block.settings.caption != blank -%}
                <figcaption class="t-label">{{ block.settings.caption | escape }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.quote != blank -%}
        <blockquote class="hi-lookbook-quote" data-reveal>{{ section.settings.quote | escape }}</blockquote>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook",
  "tag": "div",
  "class": "hi-lookbook-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Fotos de campaña pegadas como en un fanzine. Sirve para las fotos que generes en Higgsfield o para tus tomas de lookbook. Sin fotos, la sección no aparece en la tienda."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Marquilla",
      "default": "(LOOKBOOK)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "EN LA CALLE"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Cita",
      "default": "La prenda se siente antes de verse."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Foto",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Prenda que aparece (opcional)",
          "info": "La foto enlaza a la prenda. Sin foto, usa la de la prenda."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Pie de foto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        {
          "type": "frame"
        },
        {
          "type": "frame"
        },
        {
          "type": "frame"
        }
      ]
    }
  ]
}
{% endschema %}
