{%- liquid
  assign titular_words = section.settings.text | split: ' '
-%}

<section class="hi-section hi-titular color-{{ section.settings.color_scheme }} hi-titular--{{ section.settings.align }}">
  <div class="hi-container hi-titular-inner">
    {%- if section.settings.label != blank -%}
      <p class="t-label" data-reveal>{{ section.settings.label | escape }}</p>
    {%- endif -%}
    <h2 class="hi-titular-text hi-titular-text--{{ section.settings.size }}" data-reveal>
      {%- for word in titular_words -%}
        {%- assign word_style = 'fill' -%}
        {%- assign word_mod = forloop.index0 | modulo: 2 -%}
        {%- if section.settings.alternate and word_mod == 1 -%}
          {%- assign word_style = 'outline' -%}
        {%- endif -%}
        <span class="hi-titular-word hi-titular-word--{{ word_style }}">{{ word | escape }}</span>
        {%- unless forloop.last %} {% endunless -%}
      {%- endfor -%}
    </h2>
    {%- if section.settings.body != blank -%}
      <div class="t-body-l t-measure" data-reveal>{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div data-reveal>
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hi-btn hi-btn-lg hi-btn-{{ section.settings.button_style }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Titular gigante",
  "tag": "section",
  "class": "hi-titular-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Marquilla",
      "default": "(HIGHT)"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Titular",
      "default": "SI ES TU TALLA ES TUYA"
    },
    {
      "type": "checkbox",
      "id": "alternate",
      "label": "Alternar palabras rellenas y en contorno",
      "default": true
    },
    {
      "type": "select",
      "id": "size",
      "label": "Tamaño",
      "options": [
        {
          "value": "xl",
          "label": "Gigante"
        },
        {
          "value": "l",
          "label": "Grande"
        },
        {
          "value": "m",
          "label": "Mediano"
        }
      ],
      "default": "xl"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        {
          "value": "primary",
          "label": "Relleno"
        },
        {
          "value": "secondary",
          "label": "Contorno"
        }
      ],
      "default": "primary"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Titular gigante"
    }
  ]
}
{% endschema %}
