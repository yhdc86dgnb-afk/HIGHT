{%- liquid
  assign story_id = 'ColorStory-' | append: section.id
  assign story_index = 0
  assign first_color = '#dff04a'
  assign story_panels = ''
-%}

{%- capture story_swatches -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign story_collection = block.settings.collection
      if story_collection != blank and story_collection.products_count == 0
        continue
      endif

      assign story_product = block.settings.product
      assign story_color = block.settings.color
      if story_collection != blank and story_collection.metafields.custom.acento.value != blank
        assign story_color = story_collection.metafields.custom.acento.value
      endif
      assign story_name = block.settings.name
      if story_name == blank
        assign story_name = story_collection.title | default: story_product.title
      endif

      assign swatch_brightness = story_color | color_brightness
      assign swatch_on = '#0d0c0b'
      if swatch_brightness < 120
        assign swatch_on = '#ece3d0'
      endif

      assign story_index = story_index | plus: 1
      if story_index == 1
        assign first_color = story_color
      endif
      assign panel_id = story_id | append: '-' | append: block.id
    -%}
    <li {{ block.shopify_attributes }}>
      <button
        type="button"
        class="hi-story-swatch"
        style="--swatch: {{ story_color }};"
        aria-pressed="{% if story_index == 1 %}true{% else %}false{% endif %}"
        aria-controls="{{ panel_id }}"
        aria-label="{{ 'color_story.pick' | t: name: story_name }}"
        data-color="{{ story_color }}"
        data-on="{{ swatch_on }}"
        data-name="{{ story_name | escape }}"
        data-panel="{{ panel_id }}"
      >
        <span class="hi-story-dot" aria-hidden="true"></span>
        <span class="hi-story-name" aria-hidden="true">{{ story_name | escape }}</span>
        <span class="hi-story-hex t-label" aria-hidden="true">
          {%- if story_collection != blank -%}
            {{ 'general.pieces_count' | t: count: story_collection.products_count }}
          {%- else -%}
            {{ story_color | upcase }}
          {%- endif -%}
        </span>
      </button>
    </li>

    {%- capture story_panel -%}
      <figure
        class="hi-story-panel hi-accent-scope{% if story_collection != blank %} hi-story-panel--stack{% endif %}"
        id="{{ panel_id }}"
        style="--accent: {{ story_color }}; --on-accent: {{ swatch_on }};"
        {% if story_index > 1 %}
          hidden
        {% endif %}
      >
        {%- if story_collection != blank -%}
          <a
            href="{{ story_collection.url }}"
            class="hi-story-stack"
            tabindex="-1"
            aria-hidden="true"
            data-cursor="{{ 'general.cursor_view' | t }}"
          >
            {%- for story_piece in story_collection.products limit: 3 -%}
              {%- liquid
                assign piece_image = story_piece.featured_media.preview_image
                if forloop.first and block.settings.image != blank
                  assign piece_image = block.settings.image
                endif
              -%}
              <span class="hi-story-print hi-print" style="--k: {{ forloop.index0 }};">
                <span class="hi-tape"></span>
                {%- if piece_image != blank -%}
                  {{
                    piece_image
                    | image_url: width: 1000
                    | image_tag:
                      widths: '360, 500, 700, 1000',
                      sizes: '(min-width: 990px) 32vw, 66vw',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- else -%}
                  <span class="hi-media-ph">{{ 'products.photo_placeholder' | t }}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </a>
          <figcaption class="hi-story-caption">
            <span class="hi-story-caption-name">{{ story_name | escape }}</span>
            <span class="t-label">{{ 'general.pieces_count' | t: count: story_collection.products_count }}</span>
            <a href="{{ story_collection.url }}" class="hi-btn hi-btn-primary">
              {{- 'color_story.view_collection' | t }}
              {% render 'icon', name: 'arrow_forward', size: 20 -%}
            </a>
          </figcaption>
        {%- else -%}
          {%- liquid
            assign story_image = block.settings.image
            if story_image == blank and story_product != blank
              assign story_image = story_product.featured_media.preview_image
            endif
            assign story_alt = story_image.alt | default: story_product.title | default: story_name
          -%}
          <div class="hi-story-print hi-print" style="--r: {% cycle '-3deg', '2deg', '-2deg', '3deg' %};">
            <span class="hi-tape" aria-hidden="true"></span>
            {%- if story_image != blank -%}
              {{
                story_image
                | image_url: width: 1200
                | image_tag:
                  widths: '450, 600, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 40vw, 86vw',
                  loading: 'lazy',
                  alt: story_alt
              }}
            {%- else -%}
              <span class="hi-media-ph" aria-hidden="true">{{ 'products.photo_placeholder' | t }}</span>
            {%- endif -%}
          </div>
          {%- if story_product != blank -%}
            <figcaption class="hi-story-caption">
              <span class="hi-story-caption-name">{{ story_product.title | escape }}</span>
              {% render 'price', product: story_product %}
              <a href="{{ story_product.url }}" class="hi-btn hi-btn-primary">
                {{- 'general.view_piece' | t }}
                {% render 'icon', name: 'arrow_forward', size: 20 -%}
              </a>
            </figcaption>
          {%- endif -%}
        {%- endif -%}
      </figure>
    {%- endcapture -%}
    {%- assign story_panels = story_panels | append: story_panel -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  class="hi-section hi-story color-{{ section.settings.color_scheme }}"
  style="--story: {{ first_color }};"
  aria-labelledby="{{ story_id }}-title"
>
  <hi-color-story
    class="hi-container hi-story-grid"
    data-global="{{ section.settings.paint_store }}"
  >
    <div class="hi-story-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="t-label" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="t-display-l" id="{{ story_id }}-title" data-reveal>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="t-body-l hi-story-text" data-reveal>{{ section.settings.text }}</div>
      {%- endif -%}

      <ul class="hi-story-list" role="list">
        {{ story_swatches }}
      </ul>

      {%- if section.settings.paint_store -%}
        <button type="button" class="hi-btn hi-btn-ghost js-only" data-story-reset hidden>
          {%- render 'icon', name: 'undo', size: 20 %}
          {{ 'color_story.reset' | t -}}
        </button>
      {%- endif -%}
    </div>

    <div class="hi-story-stage">
      <span class="hi-story-blob" aria-hidden="true"></span>
      {{ story_panels }}
    </div>
  </hi-color-story>
</section>

{% schema %}
{
  "name": "Elige tu color",
  "tag": "section",
  "class": "hi-story-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cada color es una colección. El color sale del campo \"Color de la colección\" (metacampo custom.acento). Al tocarlo, la sección muestra sus piezas y, si lo activas, toda la tienda toma ese color."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Marquilla",
      "default": "(ELIGE TU COLOR)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "CADA COLOR TIENE SUS PIEZAS"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Cada color es una colección. Tócalo y la tienda se pinta con él.</p>"
    },
    {
      "type": "checkbox",
      "id": "paint_store",
      "label": "Pintar toda la tienda con el color elegido",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Color",
      "limit": 8,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección",
          "info": "El panel muestra sus piezas y lleva a la colección. Una colección sin piezas a la venta no aparece."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "info": "Sin nombre se usa el título de la colección."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#dff04a",
          "info": "Se usa si la colección no tiene color propio."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto distinta (opcional)",
          "info": "Reemplaza la foto de adelante."
        },
        {
          "type": "header",
          "content": "Sin colección"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Prenda de ese color",
          "info": "Si el color no tiene colección, lleva a esta prenda."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Elige tu color",
      "blocks": [
        {
          "type": "color",
          "settings": {
            "name": "ÁCIDO",
            "color": "#dff04a"
          }
        },
        {
          "type": "color",
          "settings": {
            "name": "CARMÍN",
            "color": "#c3142d"
          }
        },
        {
          "type": "color",
          "settings": {
            "name": "ÍNDIGO",
            "color": "#5b7cfa"
          }
        }
      ]
    }
  ]
}
{% endschema %}
