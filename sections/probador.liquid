{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign probador_id = 'Probador-' | append: section.id

  # Colores que van con todo: si el color del turno no tiene prendas para un puesto, va una de estos.
  assign neutral_json = ''
  assign neutral_list = section.settings.neutral_collections | split: ','
  for neutral in neutral_list
    assign neutral_clean = neutral | strip | downcase
    if neutral_clean != ''
      if neutral_json != ''
        assign neutral_json = neutral_json | append: ','
      endif
      assign neutral_json = neutral_json | append: '"' | append: neutral_clean | append: '"'
    endif
  endfor

  # Prendas disponibles con foto, por grupo (encima, arriba, abajo), como en Combínala con.
  assign json_layer = ''
  assign json_top = ''
  assign json_bottom = ''
  assign first_layer = nil
  assign first_top = nil
  assign first_bottom = nil
-%}
{%- for candidate in source.products limit: 60 -%}
  {%- if candidate.available == false or candidate.featured_media == blank -%}
    {%- continue -%}
  {%- endif -%}
  {%- capture candidate_group -%}{%- render 'outfit-group', type: candidate.type -%}{%- endcapture -%}
  {%- assign candidate_group = candidate_group | strip -%}
  {%- if candidate_group == '' -%}
    {%- continue -%}
  {%- endif -%}
  {%- liquid
    assign candidate_image = candidate.featured_media.preview_image
    assign candidate_variant = candidate.selected_or_first_available_variant
    assign candidate_alt = candidate_image.alt | default: candidate.title
  -%}
  {%- capture candidate_srcset -%}
    {{- candidate_image | image_url: width: 300 }} 300w, {{ candidate_image | image_url: width: 450 }} 450w, {{ candidate_image | image_url: width: 600 }} 600w, {{ candidate_image | image_url: width: 900 }} 900w
  {%- endcapture -%}
  {%- capture candidate_sizes -%}
    {%- unless candidate.has_only_default_variant -%}
      {%- assign size_count = 0 -%}
      {%- for size_variant in candidate.variants -%}
        {%- if size_variant.available -%}
          {%- if size_count > 0 %},{% endif -%}
          {%- assign size_count = size_count | plus: 1 -%}
          {"id":{{ size_variant.id }},"title":{{ size_variant.title | json }},"cents":{{ size_variant.price }}}
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}
  {%- endcapture -%}
  {%- capture candidate_json -%}
    {"id":{{ candidate_variant.id }},"title":{{ candidate.title | json }},"url":{{ candidate.url | json }},"type":{{ candidate.type | json }},"cents":{{ candidate_variant.price }},"src":{{ candidate_image | image_url: width: 600 | json }},"srcset":{{ candidate_srcset | json }},"w":{{ candidate_image.width | default: 600 }},"h":{{ candidate_image.height | default: 750 }},"alt":{{ candidate_alt | json }},"cols":{{ candidate.collections | map: 'handle' | json }},"sizes":[{{ candidate_sizes }}]}
  {%- endcapture -%}
  {%- liquid
    case candidate_group
      when 'layer'
        if json_layer != ''
          assign json_layer = json_layer | append: ','
        endif
        assign json_layer = json_layer | append: candidate_json
        if first_layer == nil
          assign first_layer = candidate
        endif
      when 'top'
        if json_top != ''
          assign json_top = json_top | append: ','
        endif
        assign json_top = json_top | append: candidate_json
        if first_top == nil
          assign first_top = candidate
        endif
      when 'bottom'
        if json_bottom != ''
          assign json_bottom = json_bottom | append: ','
        endif
        assign json_bottom = json_bottom | append: candidate_json
        if first_bottom == nil
          assign first_bottom = candidate
        endif
    endcase
  -%}
{%- endfor -%}
{%- liquid
  assign slot_groups = 'layer,top,bottom' | split: ','
-%}

<section class="hi-section hi-probador color-{{ section.settings.color_scheme }}" aria-labelledby="{{ probador_id }}-title">
  <hi-probador
    class="hi-container"
    data-turn-color="{{ section.settings.turn_color }}"
    data-label-fallback="{{ 'probador.fallback' | t: name: '[name]', group: '[group]', neutrals: '[neutrals]' }}"
    data-label-empty="{{ 'probador.empty' | t: group: '[group]' }}"
    data-label-size="{{ 'probador.size' | t: title: '[title]' }}"
    data-label-added="{{ 'probador.added' | t }}"
    data-label-or="{{ 'probador.or' | t }}"
  >
    <div class="hi-probador-head" data-reveal>
      <p class="t-label hi-new-eyebrow">
        {%- if section.settings.badge != blank -%}
          <b>{{ section.settings.badge | escape }}</b>
        {%- endif -%}
        {%- if section.settings.badge != blank and section.settings.eyebrow != blank %} · {% endif -%}
        {{- section.settings.eyebrow | escape -}}
      </p>
      <h2 class="t-display-l" id="{{ probador_id }}-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="hi-probador-text t-body-l t-measure">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="hi-probador-grid">
      {%- for slot_group in slot_groups -%}
        {%- liquid
          case slot_group
            when 'layer'
              assign slot_product = first_layer
            when 'top'
              assign slot_product = first_top
            else
              assign slot_product = first_bottom
          endcase
          assign slot_label = 'probador.' | append: slot_group
          assign slot_word_key = 'probador.' | append: slot_group | append: '_word'
          assign slot_word = slot_word_key | t
          assign size_subject = slot_word
          if slot_product
            assign size_subject = slot_product.title
          endif
        -%}
        <div class="hi-probador-slot" data-group="{{ slot_group }}" data-group-word="{{ slot_word }}">
          <span class="hi-probador-bg hi-tx" data-probador-bg aria-hidden="true"></span>
          <p class="hi-probador-label t-label">{{ slot_label | t }}</p>
          <div class="hi-probador-stage">
            <button
              type="button"
              class="hi-round-btn hi-probador-arrow js-only"
              data-dir="-1"
              aria-label="{{ 'probador.previous' | t: group: slot_word }}"
            >
              {%- render 'icon', name: 'chevron_left', size: 22 -%}
            </button>
            <a
              class="hi-probador-print hi-print"
              href="{% if slot_product %}{{ slot_product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
              data-probador-link
            >
              <span class="hi-tape" aria-hidden="true"></span>
              <span class="hi-probador-media">
                {%- if slot_product -%}
                  {{
                    slot_product.featured_media.preview_image
                    | image_url: width: 600
                    | image_tag:
                      widths: '300, 450, 600, 900',
                      sizes: '(min-width: 990px) 24vw, 70vw',
                      loading: 'lazy',
                      alt: slot_product.title,
                      draggable: 'false'
                  }}
                {%- else -%}
                  <img alt="" width="480" height="600" loading="lazy" hidden>
                {%- endif -%}
              </span>
            </a>
            <button
              type="button"
              class="hi-round-btn hi-probador-arrow js-only"
              data-dir="1"
              aria-label="{{ 'probador.next' | t: group: slot_word }}"
            >
              {%- render 'icon', name: 'chevron_right', size: 22 -%}
            </button>
          </div>
          <p class="hi-probador-name" data-probador-name>
            {%- if slot_product %}{{ slot_product.title | escape }}{% endif -%}
          </p>
          <p class="hi-probador-price t-label" data-probador-price>
            {%- if slot_product -%}
              {{ slot_product.price | money_without_trailing_zeros }} · {{ slot_product.type | escape }}
            {%- else -%}
              {{ 'probador.empty' | t: group: slot_word }}
            {%- endif -%}
          </p>
          <div class="hi-select-wrap hi-probador-size" data-probador-size hidden>
            <select class="hi-select" aria-label="{{ 'probador.size' | t: title: size_subject }}"></select>
            {%- render 'icon', name: 'expand_more', size: 18 -%}
          </div>
          <p class="hi-probador-note t-body-s" data-probador-note hidden></p>
        </div>
      {%- endfor -%}
    </div>

    <div class="hi-probador-bar js-only">
      <p class="hi-probador-total">
        {{- 'probador.total' | t }}
        <b data-probador-total></b>
      </p>
      <div class="hi-check" data-probador-turn hidden>
        <input type="checkbox" id="{{ probador_id }}-color" data-probador-color>
        <label for="{{ probador_id }}-color">{{ 'probador.turn_color' | t }}</label>
      </div>
      <button type="button" class="hi-btn" data-probador-shuffle>{{ 'probador.surprise' | t }}</button>
      <button type="button" class="hi-btn hi-btn-primary" data-probador-add>{{ 'probador.add' | t }}</button>
    </div>

    <script type="application/json" data-probador-data>
      {"neutrals":[{{ neutral_json }}],"groups":{"layer":[{{ json_layer }}],"top":[{{ json_top }}],"bottom":[{{ json_bottom }}]}}
    </script>
  </hi-probador>
</section>

{% schema %}
{
  "name": "Probador",
  "class": "hi-probador-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Arma un look con una prenda para encima, una arriba y una abajo, y agrega las tres al carrito. Usa los grupos de Combínala con (según el tipo de producto) y solo prendas disponibles."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Marquilla",
      "default": "Nuevo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeño",
      "default": "Probador"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Arma tu look"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Una prenda para encima, una arriba y una abajo. Cámbialas con las flechas. Con “Del color del turno”, el probador sigue al color que está en pantalla.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Prendas",
      "info": "Si queda vacío, usa todas las prendas de la tienda."
    },
    {
      "type": "checkbox",
      "id": "turn_color",
      "label": "Empezar con “Del color del turno” marcado",
      "info": "Solo con la rotación de estilo encendida.",
      "default": true
    },
    {
      "type": "text",
      "id": "neutral_collections",
      "label": "Colores que combinan con todo",
      "info": "Direcciones de las colecciones de color, separadas por comas. Si el color del turno no tiene prendas para un puesto, va una de estas.",
      "default": "ceniza, indigo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Probador"
    }
  ]
}
{% endschema %}
