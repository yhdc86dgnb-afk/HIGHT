<section class="hi-section hi-manifesto color-{{ section.settings.color_scheme }}">
  <div class="hi-container hi-manifesto-inner">
    {%- if section.settings.show_logo -%}
      <span class="hi-manifesto-logo hi-logo-img" aria-hidden="true"></span>
    {%- endif -%}
    {%- if section.settings.label != blank -%}
      <p class="t-label" data-reveal>{{ section.settings.label | escape }}</p>
    {%- endif -%}
    {%- if section.settings.quote != blank -%}
      <hi-scroll-text class="hi-manifesto-text{% if section.settings.scroll_fill %} is-fill{% endif %}">
        {{- section.settings.quote -}}
      </hi-scroll-text>
    {%- endif -%}
    <div class="hi-manifesto-foot" data-reveal>
      {%- if section.settings.signature != blank -%}
        <p class="t-label t-muted">{{ section.settings.signature | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hi-btn hi-btn-secondary">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manifiesto",
  "tag": "section",
  "class": "hi-manifesto-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Texto grande que se va encendiendo palabra por palabra al hacer scroll. Lo que pongas en negrita se enciende en el color de acento."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Marquilla",
      "default": "(MANIFIESTO)"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Texto",
      "default": "<p>Cada pieza tiene su historia: denim intervenido, parches, tintes ácidos y prendas de archivo.</p><p>La mayoría existe <strong>una sola vez</strong>. Si la ves y es tu talla, <strong>es tuya</strong>.</p>"
    },
    {
      "type": "checkbox",
      "id": "scroll_fill",
      "label": "Encender el texto con el scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Firma",
      "default": "HIGHT — MED/COL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Mostrar el logo de fondo",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Manifiesto"
    }
  ]
}
{% endschema %}
