{%- liquid
  assign manifesto_bg = 'hi-scheme color-' | append: section.settings.color_scheme
  assign manifesto_dark = false
  if section.settings.background == 'metal'
    assign manifesto_bg = 'hi-metal'
  else
    assign scheme_brightness = section.settings.color_scheme.settings.surface_000 | color_brightness
    if scheme_brightness < 128
      assign manifesto_dark = true
    endif
  endif
-%}

<section class="hi-section {{ manifesto_bg }}">
  <div class="hi-container hi-manifesto">
    {%- if section.settings.show_logo -%}
      <div class="hi-manifesto__logo">
        {%- if manifesto_dark -%}
          <img
            src="{{ 'hight-logo-plata.webp' | asset_url }}"
            width="977"
            height="672"
            alt="{{ shop.name | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <img
            src="{{ 'hight-logo-tinta.webp' | asset_url }}"
            width="977"
            height="672"
            alt="{{ shop.name | escape }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="hi-manifesto__text">
      {%- if section.settings.label != blank -%}
        <p class="t-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <div class="hi-manifesto__quote">{{ section.settings.quote }}</div>
      {%- endif -%}
      {%- if section.settings.signature != blank -%}
        <p class="t-spec">{{ section.settings.signature | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div>
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="hi-btn hi-btn-secondary">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manifiesto",
  "tag": "section",
  "class": "hi-manifesto-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Mostrar el logo principal",
      "default": true,
      "info": "Plata sobre fondos oscuros, tinta sobre plata. Mínimo 240px de ancho."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Marquilla",
      "default": "(Manifiesto)"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Texto",
      "default": "<p>Hacemos ropa para repetir.</p><p>Prendas pesadas, de corte amplio y aristas limpias, que se ven igual de bien el lunes que el sábado.</p><p>Diseñamos pocas piezas, las numeramos y las soltamos por drops.</p><p>La plata es nuestra piel; el azul, la luz que se cuela de noche.</p><p>Hecho en Medellín, para quien se viste con intención.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Firma",
      "default": "HECHO PARA REPETIR · MED/COL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        {
          "value": "metal",
          "label": "Plata cepillada"
        },
        {
          "value": "scheme",
          "label": "Esquema de color"
        }
      ],
      "default": "metal"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Manifiesto"
    }
  ]
}
{% endschema %}
