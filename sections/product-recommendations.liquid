<product-recommendations
  class="hi-section hi-scheme color-{{ section.settings.color_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ section.settings.products_to_show }}&amp;intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="hi-container" style="--cols-desktop: 4;">
      <div class="hi-section-head">
        <div class="hi-section-head__titles">
          {%- if section.settings.eyebrow != blank -%}
            <p class="t-label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="t-h2">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <ul class="hi-grid-products">
        {%- for recommendation in recommendations.products -%}
          <li>{% render 'product-card', product: recommendation %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Recomendados",
  "tag": "section",
  "class": "hi-recommendations-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Marquilla",
      "default": "(Del mismo drop)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Completa el look"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
