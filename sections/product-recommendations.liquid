{%- assign rail_id = 'Rail-' | append: section.id -%}
<product-recommendations
  class="hi-section hi-featured hi-featured--rail color-{{ section.settings.color_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ section.settings.products_to_show }}&amp;intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="hi-container">
      <div class="hi-featured-head">
        <div class="hi-featured-titles">
          {%- if section.settings.eyebrow != blank -%}
            <p class="t-label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="t-display-l">{{ section.settings.heading | escape }}</h2>
        </div>
        <div class="hi-featured-aside">
          <div class="hi-featured-actions">
            <button type="button" class="hi-round-btn js-only" aria-controls="{{ rail_id }}" aria-label="{{ 'general.previous' | t }}" data-rail-prev>
              {% render 'icon', name: 'arrow_back', size: 20 %}
            </button>
            <button type="button" class="hi-round-btn js-only" aria-controls="{{ rail_id }}" aria-label="{{ 'general.next' | t }}" data-rail-next>
              {% render 'icon', name: 'arrow_forward', size: 20 %}
            </button>
          </div>
        </div>
      </div>
    </div>
    <hi-rail class="hi-rail" data-cursor="{{ 'general.cursor_drag' | t }}">
      <ul class="hi-rail-track" id="{{ rail_id }}" role="list" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
        {%- for recommendation in recommendations.products -%}
          <li class="hi-featured-item" style="--i: {{ forloop.index0 }};">{% render 'product-card', product: recommendation %}</li>
        {%- endfor -%}
      </ul>
      <div class="hi-container">
        <div class="hi-rail-progress" role="progressbar" aria-label="{{ 'general.scroll_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="hi-rail-progress-bar"></span>
        </div>
      </div>
    </hi-rail>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Recomendados",
  "tag": "section",
  "class": "hi-recommendations-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Marquilla",
      "default": "(TAMBIÉN TE PUEDE GUSTAR)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "COMPLETA EL LOOK"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
