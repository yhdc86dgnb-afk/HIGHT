{%- liquid
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
  assign collage_heading = section.settings.heading | default: shop.name
  assign media_opacity = section.settings.media_opacity | divided_by: 100.0
  assign link_pieces = true
  if request.page_type == 'password'
    assign link_pieces = false
  endif
-%}

<section
  class="hi-collage color-{{ section.settings.color_scheme }}{% if section.settings.full_height %} hi-collage--full{% endif %}"
  aria-label="{{ collage_heading | escape }}"
>
  <hi-collage class="hi-collage-stage">
    {%- if section.settings.video != blank or section.settings.image != blank -%}
      <div class="hi-collage-bg" style="--media-opacity: {{ media_opacity }};" aria-hidden="true">
        {%- if section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              image_size: '1920x'
          }}
        {%- else -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: ''
          }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <{{ heading_tag }} class="hi-collage-logo" data-depth="-0.5">
      <span class="visually-hidden">{{ collage_heading | escape }}</span>
      <span class="hi-logo-img" aria-hidden="true"></span>
    </{{ heading_tag }}>

    {%- if section.blocks.size > 0 -%}
      <ul class="hi-collage-pieces" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign piece_product = block.settings.product
            assign piece_image = block.settings.image
            if piece_image == blank and piece_product != blank
              assign piece_image = piece_product.featured_media.preview_image
            endif
            assign piece_ratio = piece_image.aspect_ratio | default: 0.8
            if piece_ratio < 0.6
              assign piece_ratio = 0.6
            elsif piece_ratio > 1.2
              assign piece_ratio = 1.2
            endif
            assign piece_depth = forloop.index | modulo: 3 | plus: 1 | times: 0.4
            assign piece_alt = piece_image.alt | default: piece_product.title
            assign piece_tag = 'span'
            if link_pieces and piece_product != blank
              assign piece_tag = 'a'
            endif
          -%}
          <li
            class="hi-piece hi-piece--{{ block.settings.size }}"
            style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --yn: {{ block.settings.y }}; --r: {{ block.settings.rotation }}deg; --ar: {{ piece_ratio }}; --i: {{ forloop.index0 }};"
            data-piece
            data-depth="{{ piece_depth }}"
            {{ block.shopify_attributes }}
          >
            <{{ piece_tag }}
              class="hi-piece-print hi-print"
              {% if piece_tag == 'a' %}
                href="{{ piece_product.url }}" draggable="false" data-cursor="{{ 'general.cursor_drag' | t }}"
              {% endif %}
            >
            <span class="hi-tape" aria-hidden="true"></span>
            <span class="hi-piece-media">
              {%- if piece_image != blank -%}
                {{
                  piece_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 22vw, 40vw',
                    loading: 'eager',
                    alt: piece_alt,
                    draggable: 'false'
                }}
              {%- else -%}
                <span class="hi-media-ph" aria-hidden="true">{{ 'products.photo_placeholder' | t }}</span>
              {%- endif -%}
            </span>
            {%- if piece_product != blank -%}
              <span class="hi-piece-tag">
                <span class="hi-piece-name">{{ piece_product.title | escape }}</span>
                {% render 'price', product: piece_product %}
              </span>
            {%- endif -%}
            </{{ piece_tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_badge -%}
      {% render 'sticker', id: section.id, text: section.settings.badge_text, class: 'hi-collage-sticker' %}
    {%- endif -%}

    <div class="hi-collage-foot">
      <div class="hi-collage-copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-label">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="hi-collage-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <div class="hi-collage-actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hi-btn hi-btn-primary hi-btn-lg">
            {{- section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow_forward', size: 20 -%}
          </a>
        {%- endif -%}
        {%- if section.settings.show_shuffle and section.blocks.size > 1 -%}
          <button type="button" class="hi-btn hi-btn-secondary hi-btn-lg js-only" data-collage-shuffle aria-label="{{ 'general.shuffle_label' | t }}">
            {%- render 'icon', name: 'swap_vert', size: 20 %}
            {{ 'general.shuffle' | t -}}
          </button>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <p class="hi-collage-hint t-label" aria-hidden="true">
        {%- render 'icon', name: 'swap_vert', size: 16 %}
        {{ 'general.drag_hint' | t -}}
      </p>
    {%- endif -%}
  </hi-collage>
</section>

{% schema %}
{
  "name": "Hero collage",
  "tag": "section",
  "class": "hi-collage-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "El logo al centro y las prendas como fotos impresas a su alrededor. En computador se arrastran; en el teléfono flotan. El botón MEZCLAR las reparte de nuevo."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título para buscadores y lectores de pantalla",
      "default": "HIGHT — piezas únicas y denim intervenido",
      "info": "No se ve: el logo hace de titular."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Marquilla",
      "default": "(01) DENIM INTERVENIDO — MED/COL"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Piezas únicas y prendas de archivo. Cada una existe una sola vez.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "VER LAS PIEZAS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "show_shuffle",
      "label": "Mostrar el botón MEZCLAR",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Mostrar el sello que gira",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto del sello",
      "default": "PIEZA ÚNICA · NO SE REPITE · "
    },
    {
      "type": "header",
      "content": "Fondo (opcional)"
    },
    {
      "type": "paragraph",
      "content": "Aquí va un video de campaña, por ejemplo uno generado en Higgsfield. Súbelo en Contenido > Archivos o directamente en este campo."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video de fondo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto de fondo",
      "info": "Se usa si no hay video."
    },
    {
      "type": "range",
      "id": "media_opacity",
      "label": "Opacidad del fondo",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Ocupar toda la pantalla",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Foto de prenda",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Prenda"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto distinta (opcional)",
          "info": "Sin foto se usa la foto principal de la prenda."
        },
        {
          "type": "range",
          "id": "x",
          "label": "Posición horizontal",
          "min": 0,
          "max": 85,
          "step": 1,
          "unit": "%",
          "default": 10
        },
        {
          "type": "range",
          "id": "y",
          "label": "Posición vertical",
          "min": 0,
          "max": 75,
          "step": 1,
          "unit": "%",
          "default": 10
        },
        {
          "type": "range",
          "id": "rotation",
          "label": "Giro",
          "min": -15,
          "max": 15,
          "step": 1,
          "unit": "°",
          "default": -4
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tamaño",
          "options": [
            {
              "value": "s",
              "label": "Pequeña"
            },
            {
              "value": "m",
              "label": "Mediana"
            },
            {
              "value": "l",
              "label": "Grande"
            }
          ],
          "default": "m"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero collage",
      "blocks": [
        {
          "type": "piece",
          "settings": {
            "x": 6,
            "y": 8,
            "rotation": -7,
            "size": "l"
          }
        },
        {
          "type": "piece",
          "settings": {
            "x": 72,
            "y": 6,
            "rotation": 6,
            "size": "l"
          }
        },
        {
          "type": "piece",
          "settings": {
            "x": 18,
            "y": 50,
            "rotation": 5,
            "size": "m"
          }
        },
        {
          "type": "piece",
          "settings": {
            "x": 64,
            "y": 46,
            "rotation": -5,
            "size": "m"
          }
        }
      ]
    }
  ]
}
{% endschema %}
