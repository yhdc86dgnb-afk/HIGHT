{%- liquid
  assign has_media = false
  if section.settings.video != blank or section.settings.video_url != blank or section.settings.image != blank
    assign has_media = true
  endif
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}

{%- if has_media -%}
  <section class="hi-campaign color-{{ section.settings.color_scheme }} hi-campaign--{{ section.settings.height }}" aria-label="{{ section.settings.heading | default: shop.name | escape }}">
    <div class="hi-campaign-media" style="--overlay: {{ overlay }};">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            image_size: '1920x'
        }}
      {%- elsif section.settings.video_url != blank -%}
        {%- if section.settings.video_url.type == 'youtube' -%}
          {{
            section.settings.video_url
            | external_video_url: autoplay: true, loop: true, mute: true, controls: false, playlist: section.settings.video_url.id
            | external_video_tag: title: section.settings.heading
          }}
        {%- else -%}
          {{
            section.settings.video_url
            | external_video_url: autoplay: true, loop: true, muted: true, background: true
            | external_video_tag: title: section.settings.heading
          }}
        {%- endif -%}
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {%- endif -%}
    </div>
    <div class="hi-container hi-campaign-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="t-label">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="t-display-xl" data-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="t-body-l t-measure">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div>
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hi-btn hi-btn-primary hi-btn-lg">
            {{- section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow_forward', size: 20 -%}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="hi-section color-{{ section.settings.color_scheme }}">
    <div class="hi-container">
      <div class="hi-campaign-empty">
        {% render 'icon', name: 'videocam', size: 48 %}
        <p class="t-body-l">{{ 'general.placeholder_video' | t }}</p>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Video de campaña",
  "tag": "div",
  "class": "hi-campaign-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Para un video de campaña o de lookbook (por ejemplo, generado en Higgsfield). Sin video ni foto, la sección no aparece en la tienda."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video subido a Shopify",
      "info": "MP4 en bucle, sin sonido. Lo ideal: menos de 20 segundos."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "O un enlace de YouTube o Vimeo",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "O una foto"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Oscurecer el fondo",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "select",
      "id": "height",
      "label": "Alto",
      "options": [
        {
          "value": "screen",
          "label": "Pantalla completa"
        },
        {
          "value": "wide",
          "label": "Panorámico (16:9)"
        }
      ],
      "default": "screen"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Marquilla",
      "default": "(CAMPAÑA)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "EN MOVIMIENTO"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "VER LAS PIEZAS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Video de campaña"
    }
  ]
}
{% endschema %}
