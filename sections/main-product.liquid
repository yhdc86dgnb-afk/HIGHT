{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign size_guide_id = 'SizeGuide-' | append: section.id

  assign drop_prefix = settings.drop_tag_prefix | default: 'DROP' | downcase
  assign drop_prefix_size = drop_prefix | size
  assign drop_tag = ''
  for product_tag in product.tags
    assign tag_lower = product_tag | downcase
    assign tag_start = tag_lower | slice: 0, drop_prefix_size
    if drop_prefix_size > 0 and tag_start == drop_prefix
      assign drop_tag = product_tag | upcase
      break
    endif
  endfor

  assign size_option_position = 0
  for product_option in product.options_with_values
    assign option_lower = product_option.name | downcase
    if option_lower contains 'talla' or option_lower contains 'size' or option_lower == 'tamaño'
      assign size_option_position = product_option.position
      assign selected_size = product_option.selected_value
    endif
  endfor

  assign size_guide_key = product.metafields.custom.guia_tallas.value | default: ''
  if size_guide_key == ''
    assign product_kind = product.type | append: ' ' | append: product.title | downcase
    if product_kind contains 'hoodie' or product_kind contains 'buzo'
      assign size_guide_key = 'hoodie'
    elsif product_kind contains 'camiseta' or product_kind contains 'tee' or product_kind contains 'camisa'
      assign size_guide_key = 'camiseta'
    elsif product_kind contains 'pantal' or product_kind contains 'jean'
      assign size_guide_key = 'pantalon'
    else
      assign size_guide_key = 'all'
    endif
  endif

  assign stock_threshold = settings.low_stock_threshold

  # PIEZA ÚNICA solo con la etiqueta "Pieza única" y una unidad: la última de una edición dice ÚLTIMA.
  assign product_unique = false
  if product.variants.size == 1 and current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity == 1
    for product_tag in product.tags
      assign unique_tag_name = product_tag | strip | downcase
      if unique_tag_name == 'pieza única' or unique_tag_name == 'pieza unica'
        assign product_unique = true
        break
      endif
    endfor
  endif

  assign product_accent = product.metafields.custom.acento.value
  assign product_on_accent = '#0d0c0b'
  if product_accent != blank
    assign product_accent_brightness = product_accent | color_brightness
    if product_accent_brightness < 120
      assign product_on_accent = '#ece3d0'
    endif
  endif
  assign zoom_id = 'Zoom-' | append: section.id

  assign has_facts = false
  for block in section.blocks
    if block.type == 'facts'
      assign has_facts = true
      break
    endif
  endfor
-%}

<product-page
  class="hi-container hi-product{% if product_accent != blank %} hi-accent-scope{% endif %}"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-form-id="{{ form_id }}"
  {% if product_accent != blank %}
    style="--accent: {{ product_accent }}; --on-accent: {{ product_on_accent }};"
  {% endif %}
>
  <div class="hi-product-media">
    {% render 'product-gallery', product: product, current_variant: current_variant, section_id: section.id, zoom_id: zoom_id %}
    {% render 'vista-360', product: product, class: 'hi-360-btn--gallery', text: true %}
    {%- if product_unique and section.settings.show_sticker -%}
      {% render 'sticker', id: section.id, class: 'hi-product-sticker' %}
    {%- endif -%}
  </div>

  <div class="hi-product-info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'drop_tag' -%}
          {%- assign block_tag = block.settings.text | default: drop_tag -%}
          <div class="hi-product-tags" {{ block.shopify_attributes }}>
            {%- if product.type != blank -%}
              <span class="t-label">({{ product.type | upcase | escape }})</span>
            {%- endif -%}
            {%- if block_tag != blank -%}
              <span class="hi-tag hi-tag-accent">{{ block_tag | upcase | escape }}</span>
            {%- endif -%}
            {%- if product_unique -%}
              <span class="hi-tag hi-tag-accent">{{ 'products.unique_tag' | t }}</span>
            {%- elsif product.available == false -%}
              <span class="hi-tag hi-tag-ink">{{ 'products.sold_out' | t }}</span>
            {%- endif -%}
          </div>

        {%- when 'title' -%}
          <h1 class="hi-product-title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

        {%- when 'price' -%}
          <div class="hi-product-block--tight" {{ block.shopify_attributes }}>
            <div data-product-price>{% render 'price', variant: current_variant, size: 'lg' %}</div>
            {%- if block.settings.show_tax_note -%}
              <p class="t-body-s t-muted">
                {%- if cart.taxes_included -%}
                  {{ 'products.taxes_included' | t }}
                {%- endif %}
                {{ 'products.shipping_at_checkout' | t -}}
              </p>
            {%- endif -%}
          </div>

        {%- when 'spec' -%}
          {%- assign spec_text = product.metafields.custom.ficha.value | default: block.settings.text -%}
          {%- if spec_text != blank -%}
            <p class="t-spec t-muted" {{ block.shopify_attributes }}>{{ spec_text | escape }}</p>
          {%- endif -%}

        {%- when 'variant_picker' -%}
          {%- liquid
            assign fit_note = block.settings.fit_note
            assign piece_size = product.metafields.custom.talla.value
            assign piece_measures = product.metafields.custom.medidas.value
          -%}
          {%- if product.has_only_default_variant -%}
            {%- if piece_size != blank or piece_measures != blank -%}
              <div class="hi-variant-block hi-piece-size" {{ block.shopify_attributes }}>
                {%- if piece_size != blank -%}
                  <p class="hi-piece-size-row">
                    <span class="t-label">{{ 'products.size_legend' | t }}</span>
                    <span class="hi-piece-size-value">{{ piece_size | escape }}</span>
                  </p>
                {%- endif -%}
                {%- if piece_measures != blank -%}
                  <p class="hi-piece-measures">{{ piece_measures | escape | newline_to_br }}</p>
                {%- else -%}
                  <p class="hi-product-fit">{{ 'products.size_unique_note' | t }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              {%- assign contact_url = pages.contact.url | default: '/pages/contact' -%}
              <p class="hi-product-fit" {{ block.shopify_attributes }}>{{ 'products.size_ask_html' | t: url: contact_url }}</p>
            {%- endif -%}
          {%- else -%}
            <div class="hi-variant-block" {{ block.shopify_attributes }}>
              {% render 'variant-picker', product: product, section_id: section.id %}
              {%- if fit_note != blank -%}
                <p class="hi-product-fit">{{ fit_note | escape }}</p>
              {%- endif -%}
              {%- if block.settings.show_size_guide and size_option_position > 0 -%}
                <button
                  type="button"
                  class="hi-btn hi-btn-ghost hi-sizeguide-trigger js-only"
                  aria-haspopup="dialog"
                  aria-controls="{{ size_guide_id }}"
                  data-open-dialog="{{ size_guide_id }}"
                >
                  {{- 'products.size_guide' | t -}}
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'buy_buttons' -%}
          <product-form class="hi-product-buy" data-section-id="{{ section.id }}" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
              <noscript>
                <label class="visually-hidden" for="{{ form_id }}-select">{{ 'products.size_legend' | t }}</label>
                <select name="id" id="{{ form_id }}-select" class="hi-select">
                  {%- for variant in product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      {% if variant == current_variant %}
                        selected
                      {% endif %}
                      {% unless variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {{ variant.title | escape }} &mdash; {{ variant.price | money_without_trailing_zeros }}
                    </option>
                  {%- endfor -%}
                </select>
              </noscript>
              <div class="hi-product-buy__row">
                {%- if block.settings.show_quantity -%}
                  {% render 'quantity-input', name: 'quantity', value: 1, min: 1, size: 'lg' %}
                {%- endif -%}
                <button
                  type="submit"
                  name="add"
                  class="hi-btn hi-btn-primary hi-btn-lg hi-btn-block"
                  data-add-button
                  data-main-add
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >
                  {%- if current_variant.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>
              </div>
              <p class="hi-product-error" role="alert" data-product-error></p>
              {%- if block.settings.show_dynamic_checkout -%}
                <div class="hi-payment-button">{{ form | payment_button }}</div>
              {%- endif -%}
            {%- endform -%}
          </product-form>

        {%- when 'stock' -%}
          {%- liquid
            assign show_stock = false
            assign unique_piece = false
            if current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
              if product_unique
                assign unique_piece = true
              elsif stock_threshold > 0 and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= stock_threshold
                assign show_stock = true
              endif
            endif
          -%}
          <div data-product-stock {{ block.shopify_attributes }}>
            {%- if unique_piece -%}
              <p class="hi-notice hi-notice-accent">
                {% render 'icon', name: 'flare', size: 20 %}
                <span>{{ 'products.unique_note' | t }}</span>
              </p>
            {%- elsif show_stock -%}
              <p class="hi-notice hi-notice-warning">
                <span class="hi-notice-mark">{{ 'products.low_stock_tag' | t: count: current_variant.inventory_quantity }}</span>
                <span>{{ 'products.low_stock' | t: count: current_variant.inventory_quantity }}</span>
              </p>
            {%- endif -%}
          </div>

        {%- when 'description' -%}
          {%- liquid
            # Con el bloque de datos, el párrafo "Cuidado:" ya se lee en su fila y no se repite.
            assign description_html = product.description
            if has_facts and product.metafields.custom.cuidado.value != blank and description_html contains '<p>Cuidado:'
              assign care_parts = description_html | split: '<p>Cuidado:'
              assign care_text = care_parts[1] | split: '</p>' | first
              assign care_paragraph = '<p>Cuidado:' | append: care_text | append: '</p>'
              assign description_html = description_html | remove_first: care_paragraph
            endif

            # Con el bloque de datos, a la vista queda el primer párrafo y el resto se abre en "Descripción completa".
            assign description_more = ''
            if has_facts and description_html contains '<h3>'
              assign description_intro = description_html | split: '<h3>' | first
              if description_intro != blank
                assign description_more = description_html | remove_first: description_intro
              endif
            endif
          -%}
          {%- if description_more != blank -%}
            <div class="hi-product-description" {{ block.shopify_attributes }}>
              <div class="rte">{{ description_intro }}</div>
              <div class="hi-acc">
                <details class="hi-acc-item">
                  <summary class="hi-acc-btn">
                    <span>{{ 'products.description_more' | t }}</span>
                    {% render 'icon', name: 'add', size: 16, class: 'hi-acc-plus' %}
                    {% render 'icon', name: 'remove', size: 16, class: 'hi-acc-minus' %}
                  </summary>
                  <div class="hi-acc-panel rte">{{ description_more }}</div>
                </details>
              </div>
            </div>
          {%- elsif description_html != blank -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ description_html }}</div>
          {%- endif -%}

        {%- when 'facts' -%}
          {%- liquid
            assign fact_distinct = product.metafields.custom.distinto.value
            assign fact_fit = product.metafields.custom.nota_corte.value
            assign fact_material = product.metafields.custom.material.value
            assign fact_build = product.metafields.custom.confeccion.value
            assign fact_care = product.metafields.custom.cuidado.value
            assign fact_occasions = product.metafields.custom.ocasiones.value

            # El texto traducido ya sale escapado; solo se escapa el metacampo.
            assign fact_origin = product.metafields.custom.origen.value | escape
            if fact_origin == blank
              assign origin_place = block.settings.origin_place
              assign origin_brand = product.vendor | default: shop.name
              assign origin_brand_key = origin_brand | downcase | strip
              assign shop_key = shop.name | downcase | strip
              if origin_brand_key == shop_key
                if origin_place != blank
                  assign fact_origin = 'products.facts.origin_own' | t: brand: origin_brand, place: origin_place
                else
                  assign fact_origin = 'products.facts.origin_own_short' | t: brand: origin_brand
                endif
              elsif origin_place != blank
                assign fact_origin = 'products.facts.origin_other' | t: brand: origin_brand, shop: shop.name, place: origin_place
              else
                assign fact_origin = 'products.facts.origin_other_short' | t: brand: origin_brand, shop: shop.name
              endif
            endif

            assign wears = block.settings.wears

            assign shipping_url = ''
            if shop.shipping_policy.body != blank
              assign shipping_url = shop.shipping_policy.url
            elsif block.settings.shipping_page != blank
              assign shipping_url = block.settings.shipping_page.url
            endif
            assign returns_url = ''
            if shop.refund_policy.body != blank
              assign returns_url = shop.refund_policy.url
            elsif block.settings.returns_page != blank
              assign returns_url = block.settings.returns_page.url
            endif
          -%}
          <dl class="hi-facts" {{ block.shopify_attributes }}>
            {%- if fact_distinct != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.distinct' | t }}</dt>
                <dd>{{ fact_distinct | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if fact_fit != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.fit' | t }}</dt>
                <dd>{{ fact_fit | escape | newline_to_br }}</dd>
              </div>
            {%- endif -%}
            {%- if fact_material != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.material' | t }}</dt>
                <dd>{{ fact_material | escape | newline_to_br }}</dd>
              </div>
            {%- endif -%}
            {%- if fact_build != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.build' | t }}</dt>
                <dd>{{ fact_build | escape | newline_to_br }}</dd>
              </div>
            {%- endif -%}
            {%- if fact_care != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.care' | t }}</dt>
                <dd>{{ fact_care | escape | newline_to_br }}</dd>
              </div>
            {%- endif -%}
            {%- if fact_occasions != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.occasions' | t }}</dt>
                <dd>
                  <ul class="hi-facts-chips" role="list">
                    {%- for occasion in fact_occasions -%}
                      <li>{{ occasion | escape }}</li>
                    {%- endfor -%}
                  </ul>
                </dd>
              </div>
            {%- endif -%}
            {%- if wears > 0 and current_variant.price > 0 -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.per_wear' | t }}</dt>
                <dd data-product-per-wear>
                  {%- liquid
                    assign per_wear_cents = current_variant.price | times: 1.0 | divided_by: wears | divided_by: 100 | round | times: 100
                    assign per_wear_price = per_wear_cents | money_without_trailing_zeros
                    echo 'products.facts.per_wear_value' | t: wears: wears, price: per_wear_price
                  -%}
                </dd>
              </div>
            {%- endif -%}
            {%- if fact_origin != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.origin' | t }}</dt>
                <dd>{{ fact_origin }}</dd>
              </div>
            {%- endif -%}
            {%- if block.settings.shipping_text != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.shipping' | t }}</dt>
                <dd>
                  {{ block.settings.shipping_text | escape }}
                  {%- if shipping_url != blank %}
                    <a href="{{ shipping_url }}" class="hi-facts-link">{{ 'products.facts.shipping_link' | t }}</a>
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
            {%- if block.settings.returns_text != blank -%}
              <div class="hi-facts-row">
                <dt class="t-label">{{ 'products.facts.returns' | t }}</dt>
                <dd>
                  {{ block.settings.returns_text | escape }}
                  {%- if returns_url != blank %}
                    <a href="{{ returns_url }}" class="hi-facts-link">{{ 'products.facts.returns_link' | t }}</a>
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
          </dl>

        {%- when 'collapsible' -%}
          {%- liquid
            assign panel_content = block.settings.content
            if block.settings.page != blank
              assign panel_content = block.settings.page.content
            endif
          -%}
          <div class="hi-acc hi-acc-block" {{ block.shopify_attributes }}>
            <details
              class="hi-acc-item"
              {% if block.settings.open %}
                open
              {% endif %}
            >
              <summary class="hi-acc-btn">
                <span>{{ block.settings.heading | escape }}</span>
                {% render 'icon', name: 'add', size: 16, class: 'hi-acc-plus' %}
                {% render 'icon', name: 'remove', size: 16, class: 'hi-acc-minus' %}
              </summary>
              <div class="hi-acc-panel rte">
                {{ panel_content }}
                {%- if block.settings.show_care -%}
                  <ul class="hi-care">
                    <li>{% render 'icon', name: 'lavar_frio', size: 24 %}{{ 'products.care.lavar_frio' | t }}</li>
                    <li>{% render 'icon', name: 'no_blanquear', size: 24 %}{{ 'products.care.no_blanquear' | t }}</li>
                    <li>{% render 'icon', name: 'planchar_bajo', size: 24 %}{{ 'products.care.planchar_bajo' | t }}</li>
                    <li>{% render 'icon', name: 'no_secadora', size: 24 %}{{ 'products.care.no_secadora' | t }}</li>
                  </ul>
                {%- endif -%}
              </div>
            </details>
          </div>

        {%- when 'text' -%}
          <div class="rte t-body-s" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if size_option_position > 0 -%}
    <dialog
      id="{{ size_guide_id }}"
      class="hi-dialog hi-modal hi-modal-lg"
      aria-label="{{ 'products.size_guide_title' | t }}"
      data-size-option="{{ size_option_position }}"
    >
      <div class="hi-modal-head">
        <p class="hi-modal-title">{{ 'products.size_guide_title' | t }}</p>
        <button type="button" class="hi-iconbtn" aria-label="{{ 'accessibility.close' | t }}" data-close-dialog>
          {% render 'icon', name: 'close' %}
        </button>
      </div>
      <div class="hi-modal-body">
        {%- assign size_guide_page = section.settings.size_guide_page -%}
        {%- if size_guide_page != blank -%}
          <div class="rte">{{ size_guide_page.content }}</div>
        {%- else -%}
          <p class="hi-sizeguide-note hi-sizeguide-intro">{{ 'products.size_guide_note' | t }}</p>
          {% render 'size-guide', guide: size_guide_key, highlight: selected_size %}
        {%- endif -%}
      </div>
    </dialog>
  {%- endif -%}

  <dialog id="{{ zoom_id }}" class="hi-dialog hi-zoom" aria-label="{{ 'products.zoom_title' | t: title: product.title }}">
    <button type="button" class="hi-header-btn hi-zoom-close" aria-label="{{ 'accessibility.close' | t }}" data-close-dialog>
      <span aria-hidden="true">{{ 'accessibility.close_button' | t }}</span>
      {% render 'icon', name: 'close', size: 20 %}
    </button>
    <ul class="hi-zoom-list" role="list">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <li id="{{ zoom_id }}-{{ media.id }}">
            {{
              media
              | image_url: width: 2400
              | image_tag:
                widths: '900, 1400, 1800, 2400',
                sizes: '100vw',
                loading: 'lazy',
                alt: media.alt
            }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </dialog>

  {%- if section.settings.sticky_bar -%}
    <div class="hi-buybar" data-buybar aria-hidden="true">
      <div class="hi-buybar-info">
        <span class="hi-buybar-name">{{ product.title | escape }}</span>
        <span data-product-price>{% render 'price', variant: current_variant %}</span>
      </div>
      <button
        type="submit"
        form="{{ form_id }}"
        class="hi-btn hi-btn-primary"
        tabindex="-1"
        data-buybar-button
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        {%- if current_variant.available -%}
          {{ 'products.quick_add' | t }}
        {%- else -%}
          {{ 'products.sold_out' | t }}
        {%- endif -%}
      </button>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "media_id": {{ variant.featured_media.id | json }}
        }
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    ]
  </script>
</product-page>

{% schema %}
{
  "name": "Ficha de producto",
  "tag": "section",
  "class": "hi-main-product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_sticker",
      "label": "Sello que gira en las piezas únicas",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_bar",
      "label": "Barra fija para comprar en el teléfono",
      "default": true
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Página con la guía de tallas",
      "info": "Opcional. Sin página se muestran las tablas base (camiseta, hoodie, pantalón) según el tipo de producto o el metacampo custom.guia_tallas."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "drop_tag",
      "name": "Marquillas",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Muestra el tipo de prenda, la etiqueta de drop (ej. DROP 06) y PIEZA ÚNICA cuando la prenda tiene la etiqueta \"Pieza única\" y una sola unidad."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto fijo (opcional)"
        }
      ]
    },
    {
      "type": "title",
      "name": "Nombre",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Precio",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Mostrar nota de impuestos y envío",
          "default": true
        }
      ]
    },
    {
      "type": "spec",
      "name": "Ficha técnica",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
