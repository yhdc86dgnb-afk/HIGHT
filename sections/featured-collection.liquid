{%- liquid
  assign featured = section.settings.collection
  assign products_limit = section.settings.products_to_show
  assign placeholder_titles = 'Camiseta Boxy Concreto|Hoodie Boxy Niebla|Pantalón Wide Carbón|Jean Barrel Negro Lavado|Camiseta Boxy Plata|Chaqueta Coach Azul Noche|Pantalón Cargo Carbón|Gorra Seis Paneles Plata' | split: '|'
  assign placeholder_metas = 'Boxy · 280 g/m²|Boxy · 400 g/m²|Wide · Gabardina|Barrel · Denim 14 oz|Boxy · 280 g/m²|Coach · Nylon|Cargo · Ripstop|Seis paneles · Twill' | split: '|'
  assign placeholder_prices = '18900000|26900000|23900000|25900000|18900000|29900000|22900000|12900000' | split: '|'
-%}

<section class="hi-section hi-scheme color-{{ section.settings.color_scheme }}">
  <div class="hi-container" style="--cols-desktop: {{ section.settings.columns_desktop }};">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.text != blank
    -%}
      <div class="hi-section-head">
        <div class="hi-section-head__titles">
          {%- if section.settings.eyebrow != blank -%}
            <p class="t-label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="t-display-l">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="hi-section-head__text">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.view_all_label != blank and featured != blank -%}
          <a href="{{ featured.url }}" class="hi-btn hi-btn-secondary">{{ section.settings.view_all_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="hi-grid-products">
      {%- if featured != blank and featured.products_count > 0 -%}
        {%- for product in featured.products limit: products_limit -%}
          <li>
            {%- if forloop.index <= 2 and section.index <= 2 -%}
              {% render 'product-card', product: product, eager: true %}
            {%- else -%}
              {% render 'product-card', product: product %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_limit) -%}
          {%- assign placeholder_index = forloop.index0 | modulo: 8 -%}
          {%- assign placeholder_price = placeholder_prices[placeholder_index] | times: 1 -%}
          <li>
            {% render 'product-card',
              placeholder_title: placeholder_titles[placeholder_index],
              placeholder_meta: placeholder_metas[placeholder_index],
              placeholder_price: placeholder_price
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Catálogo del drop",
  "tag": "section",
  "class": "hi-featured-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Marquilla",
      "default": "DROP 05 — PLATA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "EL DROP"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Siete piezas. 300 unidades numeradas. Cuando se acaban, no vuelven.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del botón",
      "default": "VER TODO"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Catálogo del drop"
    }
  ]
}
{% endschema %}
