{%- liquid
  assign featured = section.settings.collection
  assign products_limit = section.settings.products_to_show
  assign featured_count = 0
  if featured != blank
    assign featured_count = featured.products_count
    if featured_count > products_limit
      assign featured_count = products_limit
    endif
  endif
  assign rail_id = 'Rail-' | append: section.id
  assign placeholder_titles = 'Jean Flare Patchwork|Jean Wide Índigo|Camiseta Estampada|Top de Malla|Jean Destroyed|Chaqueta Intervenida' | split: '|'
  assign placeholder_prices = '69000000|59000000|16900000|39000000|49000000|55000000' | split: '|'
-%}

<section class="hi-section hi-featured color-{{ section.settings.color_scheme }} hi-featured--{{ section.settings.layout }}">
  <div class="hi-container">
    <div class="hi-featured-head" data-reveal>
      <div class="hi-featured-titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-label">
            {{- section.settings.eyebrow | escape -}}
            {%- if featured_count > 0 %} {{ 'general.pieces_count' | t: count: featured_count }}{% endif -%}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="t-display-xl">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div class="hi-featured-aside">
        {%- if section.settings.text != blank -%}
          <div class="hi-featured-text t-body-l">{{ section.settings.text }}</div>
        {%- endif -%}
        <div class="hi-featured-actions">
          {%- if section.settings.layout == 'rail' -%}
            <button type="button" class="hi-round-btn js-only" aria-controls="{{ rail_id }}" aria-label="{{ 'general.previous' | t }}" data-rail-prev>
              {% render 'icon', name: 'arrow_back', size: 20 %}
            </button>
            <button type="button" class="hi-round-btn js-only" aria-controls="{{ rail_id }}" aria-label="{{ 'general.next' | t }}" data-rail-next>
              {% render 'icon', name: 'arrow_forward', size: 20 %}
            </button>
          {%- endif -%}
          {%- if section.settings.view_all_label != blank and featured != blank -%}
            <a href="{{ featured.url }}" class="hi-btn hi-btn-secondary">{{ section.settings.view_all_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- capture featured_items -%}
    {%- if featured != blank and featured.products_count > 0 -%}
      {%- for product in featured.products limit: products_limit -%}
        <li class="hi-featured-item" style="--i: {{ forloop.index0 }};">
          {%- if forloop.index <= 3 and section.index <= 2 -%}
            {% render 'product-card', product: product, eager: true %}
          {%- else -%}
            {% render 'product-card', product: product %}
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..products_limit) -%}
        {%- assign placeholder_index = forloop.index0 | modulo: 6 -%}
        {%- assign placeholder_price = placeholder_prices[placeholder_index] | times: 1 -%}
        <li class="hi-featured-item" style="--i: {{ forloop.index0 }};">
          {% render 'product-card', placeholder_title: placeholder_titles[placeholder_index], placeholder_price: placeholder_price %}
        </li>
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- if section.settings.layout == 'rail' -%}
    <hi-rail class="hi-rail" data-cursor="{{ 'general.cursor_drag' | t }}">
      <ul class="hi-rail-track" id="{{ rail_id }}" role="list" tabindex="0" aria-label="{{ section.settings.heading | default: featured.title | escape }}">
        {{ featured_items }}
      </ul>
      <div class="hi-container">
        <div class="hi-rail-progress" role="progressbar" aria-label="{{ 'general.scroll_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="hi-rail-progress-bar"></span>
        </div>
      </div>
    </hi-rail>
  {%- else -%}
    <div class="hi-container">
      <ul class="hi-grid-products" role="list" style="--cols-desktop: {{ section.settings.columns_desktop }};">
        {{ featured_items }}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Prendas destacadas",
  "tag": "section",
  "class": "hi-featured-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Diseño",
      "options": [
        {
          "value": "rail",
          "label": "Fila que se arrastra"
        },
        {
          "value": "grid",
          "label": "Retícula"
        }
      ],
      "default": "rail"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Marquilla",
      "default": "(DISPONIBLES)",
      "info": "Se le suma el número de piezas."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "LO QUE HAY"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Una de cada una. Cuando se vende, se va del archivo.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Productos",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas en escritorio (retícula)",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del botón",
      "default": "VER TODO"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Prendas destacadas"
    }
  ]
}
{% endschema %}
