<div class="hi-password hi-metal">
  <div class="hi-password__main">
    <img
      src="{{ 'hight-logo-tinta.webp' | asset_url }}"
      width="977"
      height="672"
      alt="{{ shop.name | escape }}"
      class="hi-hero-logo"
    >
    <p class="t-label">({{ section.settings.label | default: 'Próximo drop' | escape }})</p>
    {%- if shop.password_message != blank -%}
      <p class="t-body-l t-measure">{{ shop.password_message | escape }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'hi-inline-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <div class="hi-field">
        <label for="PasswordNewsletterEmail">{{ 'newsletter.label' | t }}</label>
        <input
          id="PasswordNewsletterEmail"
          type="email"
          name="contact[email]"
          autocomplete="email"
          placeholder="{{ 'newsletter.placeholder' | t }}"
          required
        >
        {%- if form.posted_successfully? -%}
          <span class="hi-field-hint" role="status">{{ 'newsletter.success' | t }}</span>
        {%- elsif form.errors -%}
          <span class="hi-field-error" role="alert">{{ form.errors | default_errors }}</span>
        {%- else -%}
          <span class="hi-field-hint">{{ 'newsletter.hint' | t }}</span>
        {%- endif -%}
      </div>
      <button type="submit" class="hi-btn hi-btn-primary">{{ 'newsletter.submit' | t }}</button>
    {%- endform -%}

    {%- form 'storefront_password', class: 'hi-password-form' -%}
      <details
        class="hi-acc-item"
        {% if form.errors %}
          open
        {% endif %}
      >
        <summary class="hi-acc-btn">
          <span>{{ 'password.enter' | t }}</span>
          {% render 'icon', name: 'lock', size: 20 %}
        </summary>
        <div class="hi-inline-form">
          <div class="hi-field{% if form.errors %} hi-field-invalid{% endif %}">
            <label for="StorefrontPassword">{{ 'password.password' | t }}</label>
            <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
            {%- if form.errors -%}
              <span class="hi-field-error" role="alert">{{ form.errors | default_errors }}</span>
            {%- endif -%}
          </div>
          <button type="submit" class="hi-btn hi-btn-secondary">{{ 'password.submit' | t }}</button>
        </div>
      </details>
    {%- endform -%}
  </div>
  <div class="hi-password__foot t-label">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase | escape }}</span>
    <span>MED/COL</span>
  </div>
</div>

{% schema %}
{
  "name": "Contraseña",
  "tag": "section",
  "class": "hi-main-password-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Marquilla",
      "default": "Próximo drop"
    }
  ]
}
{% endschema %}
