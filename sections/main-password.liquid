<div class="hi-password color-{{ section.settings.color_scheme }}">
  <div class="hi-password-stage">
    <hi-collage class="hi-collage-stage hi-collage-stage--password">
      <h1 class="hi-collage-logo" data-depth="-0.5">
        <span class="visually-hidden">{{ shop.name | escape }}</span>
        <span class="hi-logo-img" aria-hidden="true"></span>
      </h1>

      {%- if section.blocks.size > 0 -%}
        <ul class="hi-collage-pieces" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign piece_product = block.settings.product
              assign piece_image = block.settings.image
              if piece_image == blank and piece_product != blank
                assign piece_image = piece_product.featured_media.preview_image
              endif
              assign piece_ratio = piece_image.aspect_ratio | default: 0.8
              if piece_ratio < 0.6
                assign piece_ratio = 0.6
              elsif piece_ratio > 1.2
                assign piece_ratio = 1.2
              endif
              assign piece_depth = forloop.index | modulo: 3 | plus: 1 | times: 0.4
            -%}
            {%- if piece_image != blank -%}
              <li
                class="hi-piece hi-piece--{{ block.settings.size }}"
                style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --yn: {{ block.settings.y }}; --r: {{ block.settings.rotation }}deg; --ar: {{ piece_ratio }}; --i: {{ forloop.index0 }};"
                data-piece
                data-depth="{{ piece_depth }}"
                {{ block.shopify_attributes }}
              >
                <span class="hi-piece-print hi-print">
                  <span class="hi-tape" aria-hidden="true"></span>
                  <span class="hi-piece-media">
                    {{
                      piece_image
                      | image_url: width: 800
                      | image_tag:
                        widths: '300, 450, 600, 800',
                        sizes: '(min-width: 990px) 20vw, 38vw',
                        loading: 'eager',
                        alt: '',
                        draggable: 'false'
                    }}
                  </span>
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {% render 'sticker', id: section.id, text: section.settings.badge_text, class: 'hi-collage-sticker' %}
    </hi-collage>
  </div>

  <div class="hi-container hi-password-panel">
    <div class="hi-password-copy">
      <p class="t-label">({{ section.settings.label | default: 'Próximamente' | escape }})</p>
      <h2 class="t-display-l">{{ section.settings.heading | escape }}</h2>
      {%- if shop.password_message != blank -%}
        <p class="t-body-l t-measure">{{ shop.password_message | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hi-password-forms">
      {%- form 'customer', class: 'hi-footer-form' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        <div class="hi-field">
          <label for="PasswordNewsletterEmail">{{ 'newsletter.email_label' | t }}</label>
          <div class="hi-field-inline">
            <input
              id="PasswordNewsletterEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
            >
            <button type="submit" class="hi-btn hi-btn-primary">{{ 'newsletter.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <span class="hi-form-success" role="status">{{ 'newsletter.success' | t }}</span>
          {%- elsif form.errors -%}
            <span class="hi-field-error" role="alert">{{ form.errors | default_errors }}</span>
          {%- else -%}
            <span class="hi-field-hint">{{ 'newsletter.hint' | t }}</span>
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- form 'storefront_password', class: 'hi-password-form' -%}
        <details
          class="hi-acc-item"
          {% if form.errors %}
            open
          {% endif %}
        >
          <summary class="hi-acc-btn">
            <span>{{ 'password.enter' | t }}</span>
            {% render 'icon', name: 'lock', size: 20 %}
          </summary>
          <div class="hi-field">
            <label for="StorefrontPassword">{{ 'password.password' | t }}</label>
            <div class="hi-field-inline">
              <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
              <button type="submit" class="hi-btn hi-btn-secondary">{{ 'password.submit' | t }}</button>
            </div>
            {%- if form.errors -%}
              <span class="hi-field-error" role="alert">{{ form.errors | default_errors }}</span>
            {%- endif -%}
          </div>
        </details>
      {%- endform -%}
    </div>
  </div>

  <div class="hi-band hi-bg-accent hi-band--m hi-password-band">
    <hi-marquee class="hi-marquee" style="--marquee-duration: 30s;" data-speed="30">
      <div class="hi-marquee-track">
        {%- capture password_items -%}
          <li class="hi-band-item">{{ shop.name | upcase | escape }}</li>
          <li class="hi-band-sep" aria-hidden="true">{% render 'icon', name: 'flare', size: 32 %}</li>
          <li class="hi-band-item hi-band-item--outline">{{ section.settings.label | default: 'Próximamente' | upcase | escape }}</li>
          <li class="hi-band-sep" aria-hidden="true">{% render 'icon', name: 'flare', size: 32 %}</li>
        {%- endcapture -%}
        <ul class="hi-marquee-group" role="list" aria-hidden="true">
          {{ password_items }}
          {{ password_items }}
          {{ password_items }}
        </ul>
        <ul class="hi-marquee-group" role="list" aria-hidden="true">
          {{ password_items }}
          {{ password_items }}
          {{ password_items }}
        </ul>
      </div>
    </hi-marquee>
  </div>

  <div class="hi-container hi-password-foot t-label">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase | escape }}</span>
    <span>MED/COL</span>
  </div>
</div>

{% schema %}
{
  "name": "Contraseña",
  "tag": "section",
  "class": "hi-main-password-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Es lo que ve el público mientras la tienda tiene contraseña. El mensaje se edita en Tienda online > Preferencias."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Marquilla",
      "default": "Próximamente"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "LA TIENDA ABRE PRONTO"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto del sello",
      "default": "PIEZAS ÚNICAS · PRÓXIMAMENTE · "
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Foto de prenda",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Prenda"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto distinta (opcional)"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Posición horizontal",
          "min": 0,
          "max": 85,
          "step": 1,
          "unit": "%",
          "default": 10
        },
        {
          "type": "range",
          "id": "y",
          "label": "Posición vertical",
          "min": 0,
          "max": 75,
          "step": 1,
          "unit": "%",
          "default": 10
        },
        {
          "type": "range",
          "id": "rotation",
          "label": "Giro",
          "min": -15,
          "max": 15,
          "step": 1,
          "unit": "°",
          "default": -4
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tamaño",
          "options": [
            {
              "value": "s",
              "label": "Pequeña"
            },
            {
              "value": "m",
              "label": "Mediana"
            },
            {
              "value": "l",
              "label": "Grande"
            }
          ],
          "default": "m"
        }
      ]
    }
  ]
}
{% endschema %}
