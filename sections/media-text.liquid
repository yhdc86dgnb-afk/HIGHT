{%- assign media_alt = section.settings.image.alt | default: section.settings.heading -%}
<section class="hi-section hi-scheme color-{{ section.settings.color_scheme }}">
  <div class="hi-container hi-media-text{% if section.settings.reverse %} hi-media-text--reverse{% endif %}">
    <div class="hi-media-text__media" style="--media-ratio: {{ section.settings.ratio }};">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            loading: 'lazy',
            alt: media_alt
        }}
      {%- else -%}
        <span class="hi-media-ph" aria-hidden="true">FOTO</span>
      {%- endif -%}
    </div>
    <div class="hi-richtext">
      {%- if section.settings.label != blank -%}
        <p class="t-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="t-h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte t-body-l">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div>
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="hi-btn hi-btn-{{ section.settings.button_style }}">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Foto con texto",
  "tag": "section",
  "class": "hi-media-text-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción",
      "options": [
        {
          "value": "4 / 5",
          "label": "4:5 producto"
        },
        {
          "value": "3 / 4",
          "label": "3:4 retrato"
        },
        {
          "value": "3 / 2",
          "label": "3:2 editorial"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Foto a la derecha",
      "default": false
    },
    {
      "type": "text",
      "id": "label",
      "label": "Marquilla",
      "default": "100% ALGODÓN · 280 G/M²"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Pesada, amplia, para repetir"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Hombros caídos, largo corto, cuello de 2 cm. Algodón peinado, lavado a la piedra para que caiga recto desde el primer uso.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "VER LA CAMISETA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        {
          "value": "primary",
          "label": "Relleno"
        },
        {
          "value": "secondary",
          "label": "Contorno"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Foto con texto"
    }
  ]
}
{% endschema %}
