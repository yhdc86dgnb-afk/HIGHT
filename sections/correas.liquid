{%- liquid
  assign band_class = 'hi-bg-accent'
  if section.settings.background == 'scheme'
    assign band_class = 'color-' | append: section.settings.color_scheme
  endif
  assign second = 'right'
  if section.settings.direction == 'right'
    assign second = 'left'
  endif
-%}

{%- comment -%}
  Las 12 correas de tachas, dibujadas en vector (bocetos/correas/), en dos filas que corren en sentidos contrarios:
  arriba las seis primeras de la foto, abajo las otras seis. Con la ficha de las correas elegida, cada una lleva a su
  opción. La copia de cada fila, la que da la vuelta, también se puede tocar: queda fuera del lector de pantalla y del
  tabulador, pero no inerte.
{%- endcomment -%}
<div class="hi-band-wrap" style="--tilt: {{ section.settings.tilt }}deg;">
  <div class="hi-band hi-belts {{ band_class }}">
    {%- for row in (1..2) -%}
      {%- liquid
        if row == 1
          assign row_first = 1
          assign row_direction = section.settings.direction
        else
          assign row_first = 7
          assign row_direction = second
        endif
        assign row_last = row_first | plus: 5
      -%}
      <hi-marquee
        class="hi-marquee"
        style="--marquee-duration: {{ section.settings.speed }}s;"
        data-speed="{{ section.settings.speed }}"
        data-direction="{{ row_direction }}"
        data-scroll-boost="{{ section.settings.scroll_boost }}"
        data-calm="slow"
      >
        <div class="hi-marquee-track">
          <ul class="hi-marquee-group" role="list">
            {%- for i in (row_first..row_last) -%}
              {%- render 'correa', number: i, product: section.settings.product -%}
            {%- endfor -%}
          </ul>
          <ul class="hi-marquee-group" role="list" aria-hidden="true">
            {%- for i in (row_first..row_last) -%}
              {%- render 'correa', number: i, product: section.settings.product, copy: true -%}
            {%- endfor -%}
          </ul>
        </div>
      </hi-marquee>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Correas",
  "tag": "section",
  "class": "hi-band-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Las correas de tachas, dibujadas en vector, corren de lado a lado en dos filas. Al hacer scroll se aceleran."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Ficha de las correas",
      "info": "Cada correa lleva a la opción con su número: la 01 a la opción 01, y así. Las que ya se vendieron se ven apagadas."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duración de una vuelta",
      "min": 40,
      "max": 240,
      "step": 10,
      "unit": "s",
      "default": 120
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Dirección de la fila de arriba",
      "options": [
        {
          "value": "left",
          "label": "Hacia la izquierda"
        },
        {
          "value": "right",
          "label": "Hacia la derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "scroll_boost",
      "label": "Acelerar con el scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "tilt",
      "label": "Inclinación",
      "min": -4,
      "max": 4,
      "step": 1,
      "unit": "°",
      "default": -2
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        {
          "value": "accent",
          "label": "Color de acento"
        },
        {
          "value": "scheme",
          "label": "Esquema de color"
        }
      ],
      "default": "accent"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-3",
      "visible_if": "{{ section.settings.background == 'scheme' }}"
    }
  ],
  "presets": [
    {
      "name": "Correas"
    }
  ]
}
{% endschema %}
